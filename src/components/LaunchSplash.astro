<div
  id="full-colour-launch"
  class="fixed inset-0 z-[100] hidden overflow-y-auto bg-slate-950 text-white"
  role="dialog"
  aria-modal="true"
  aria-labelledby="full-colour-launch-title"
>
  <div class="relative isolate flex min-h-full items-center overflow-hidden">
    <img
      src="/images/uv-printing/uv-launch-hero.webp"
      alt="Colour-printed tumblers, phone cases, apparel, signs, stickers, labels, and decals"
      class="absolute inset-0 h-full w-full object-cover object-[64%_center] sm:object-center"
    />
    <div class="absolute inset-0 bg-gradient-to-r from-black/95 via-black/75 to-black/5"></div>
    <div class="absolute inset-0 bg-gradient-to-t from-black/45 via-transparent to-black/15"></div>

    <button
      id="full-colour-launch-close"
      type="button"
      class="absolute right-5 top-5 z-20 inline-flex h-12 w-12 items-center justify-center rounded-full border border-white/25 bg-black/50 text-2xl text-white backdrop-blur transition hover:border-yellow-400 hover:bg-yellow-400 hover:text-slate-950 sm:right-8 sm:top-8"
      aria-label="Close launch announcement"
    >
      <span aria-hidden="true">×</span>
    </button>

    <div class="relative mx-auto w-full max-w-7xl px-6 py-14 sm:py-16 lg:py-20">
      <div class="max-w-3xl">
        <div class="inline-flex items-center gap-3 rounded-full border border-yellow-400/50 bg-yellow-400/15 px-4 py-2 backdrop-blur">
          <span class="h-2.5 w-2.5 animate-pulse rounded-full bg-yellow-400"></span>
          <span class="text-xs font-black uppercase tracking-[0.24em] text-yellow-300 sm:text-sm">
            Now available in Surrey
          </span>
        </div>

        <p class="mt-5 text-sm font-bold uppercase tracking-[0.35em] text-slate-300">
          A new way to make your ideas real
        </p>
        <h2
          id="full-colour-launch-title"
          class="mt-3 text-5xl font-black leading-[1.08] tracking-tight sm:text-6xl lg:text-7xl"
        >
          <span class="block">Digital full-colour</span>
          <span class="block">printing is&nbsp;<span class="text-yellow-400">here.</span></span>
        </h2>

        <p class="mt-5 max-w-xl text-lg leading-7 text-slate-200 sm:text-xl sm:leading-8">
          Vibrant custom products, branded merchandise, apparel, and decals—printed locally for one-of-a-kind gifts, growing businesses, and bold ideas.
        </p>

        <div class="mt-6 flex flex-wrap gap-2 text-sm font-semibold text-slate-100">
          <span class="rounded-full border border-white/20 bg-black/35 px-4 py-2 backdrop-blur">Tumblers</span>
          <span class="rounded-full border border-white/20 bg-black/35 px-4 py-2 backdrop-blur">Phone Cases</span>
          <span class="rounded-full border border-white/20 bg-black/35 px-4 py-2 backdrop-blur">Signs &amp; Plaques</span>
          <span class="rounded-full border border-white/20 bg-black/35 px-4 py-2 backdrop-blur">T-Shirts</span>
          <span class="rounded-full border border-white/20 bg-black/35 px-4 py-2 backdrop-blur">DTF Transfers</span>
          <span class="rounded-full border border-white/20 bg-black/35 px-4 py-2 backdrop-blur">Stickers &amp; Decals</span>
        </div>

        <div class="mt-7 flex flex-col gap-3 sm:flex-row">
          <a
            href="/uv-printing"
            class="inline-flex items-center justify-center rounded-xl bg-yellow-400 px-8 py-4 text-lg font-black text-slate-950 transition hover:-translate-y-0.5 hover:bg-yellow-300"
          >
            Explore Full-Colour Printing
            <span class="ml-2" aria-hidden="true">→</span>
          </a>
          <a
            href="/quote/uv-printing"
            class="inline-flex items-center justify-center rounded-xl border border-white/40 bg-white/10 px-8 py-4 text-lg font-bold text-white backdrop-blur transition hover:-translate-y-0.5 hover:bg-white/20"
          >
            Start a Printing Quote
          </a>
        </div>

        <a
          href="/"
          class="mt-5 text-sm font-semibold text-slate-300 underline decoration-white/30 underline-offset-4 transition hover:text-white"
        >
          Continue to Layer Forge Canada
        </a>
      </div>
    </div>
  </div>
</div>

<script>
  const splash = document.getElementById("full-colour-launch");
  const closeButton = document.getElementById("full-colour-launch-close");
  const storageKey = "layerforge-full-colour-launch-seen";

  const closeSplash = () => {
    splash?.classList.add("hidden");
    document.body.classList.remove("overflow-hidden");
    window.sessionStorage.setItem(storageKey, "true");
  };

  if (splash && !window.sessionStorage.getItem(storageKey)) {
    splash.classList.remove("hidden");
    document.body.classList.add("overflow-hidden");
    window.requestAnimationFrame(() => closeButton?.focus());
  }

  closeButton?.addEventListener("click", closeSplash);

  splash?.querySelectorAll("a").forEach((link) => {
    link.addEventListener("click", () => {
      window.sessionStorage.setItem(storageKey, "true");
    });
  });

  document.addEventListener("keydown", (event) => {
    if (event.key === "Escape" && splash && !splash.classList.contains("hidden")) {
      closeSplash();
    }
  });
</script>
