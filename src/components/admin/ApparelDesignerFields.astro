---
interface Props {
  enabled?: boolean;
  backPrintPrice?: number | string | null;
  dedicated?: boolean;
}

const { enabled = false, backPrintPrice = 8, dedicated = false } = Astro.props;
---

<section class="rounded-xl border border-yellow-300 bg-yellow-50 p-5">
  <h2 class="text-lg font-bold text-slate-950">Interactive Apparel Designer</h2>
  <p class="mt-2 text-sm leading-6 text-slate-600">
    Customers can upload front and back artwork, position it on a live garment
    mockup, and enter exact print dimensions.
  </p>

  {dedicated ? (
    <input type="hidden" name="apparel_designer_enabled" value="on" />
  ) : (
    <label class="mt-5 flex items-start gap-3 rounded-lg border border-yellow-300 bg-white p-4">
      <input
        type="checkbox"
        name="apparel_designer_enabled"
        checked={enabled}
        class="mt-1 h-5 w-5 accent-yellow-500"
      />
      <span>
        <span class="block font-semibold text-slate-950">Enable apparel designer</span>
        <span class="mt-1 block text-sm leading-5 text-slate-500">
          Add inventory combinations below for every quality, colour and size you sell.
        </span>
      </span>
    </label>
  )}

  <div class="mt-5 max-w-sm">
    <label for="apparel_back_print_price" class="mb-2 block font-semibold">
      Additional back print (CAD per shirt)
    </label>
    <input
      id="apparel_back_print_price"
      type="number"
      name="apparel_back_print_price"
      min="0"
      max="500"
      step="0.01"
      value={Number(backPrintPrice ?? 8).toFixed(2)}
      class="w-full rounded-lg border p-3"
    />
    <p class="mt-2 text-sm leading-5 text-slate-500">
      Charged only when the customer prints both the front and back. A single printed side is included in the product or quality-variant price.
    </p>
  </div>
</section>
