---
const categories = [
  { title: "Personalized Products", description: "Thoughtful items made around your artwork, message, or occasion.", examples: ["Drinkware", "Phone cases", "Gifts & keepsakes", "Awards & plaques"], image: "/images/uv-printing/uv-tumbler.webp", href: "/what-we-make#personalized-products", action: "View product ideas" },
  { title: "Business Branding", description: "Coordinated products that help your business look consistent.", examples: ["Promotional items", "Branded apparel", "Employee gifts", "Product labels"], image: "/images/solutions/promotional-products.png", href: "/for-businesses", action: "Explore business branding" },
  { title: "Custom Apparel", description: "Branded clothing and fabric products for businesses, teams, events, and individuals.", examples: ["T-shirts & polos", "Hoodies & sweatshirts", "Caps & aprons", "Workwear & uniforms"], image: "/images/apparel/custom-apparel-layerforge.webp", href: "/what-we-make#apparel", action: "View apparel options" },
  { title: "Shop", description: "Products with available options that can be ordered and paid for online.", examples: ["Custom T-shirts", "Tool storage", "Automotive items", "Functional products"], image: "/images/3d-printing/functional-products.webp", href: "/shop", action: "Shop online" },
];
---

<section class="bg-white py-24 sm:py-28">
  <div class="mx-auto max-w-7xl px-6">
    <div class="max-w-3xl">
      <p class="text-sm font-bold uppercase tracking-[0.28em] text-yellow-600">Custom product catalogue</p>
      <h2 class="mt-4 text-4xl font-bold tracking-tight text-slate-950 sm:text-5xl">See what Layer Forge can create for you.</h2>
      <p class="mt-6 text-lg leading-8 text-slate-600">Browse our main categories and real examples. Custom projects begin with a conversation; products shown in the Shop can be ordered online.</p>
    </div>
    <div class="mt-14 grid gap-6 md:grid-cols-2">
      {categories.map((category) => (
        <a href={category.href} class="group overflow-hidden rounded-3xl border border-slate-200 bg-slate-950 shadow-sm transition duration-300 hover:-translate-y-1 hover:shadow-xl">
          <div class="relative h-72 overflow-hidden"><img src={category.image} alt="" loading="lazy" class="h-full w-full object-cover transition duration-500 group-hover:scale-105" /><div class="absolute inset-0 bg-gradient-to-t from-slate-950 via-slate-950/25 to-transparent"></div></div>
          <div class="p-7 text-white">
            <h3 class="text-2xl font-bold group-hover:text-yellow-400">{category.title}</h3>
            <p class="mt-3 leading-7 text-slate-300">{category.description}</p>
            <ul class="mt-5 flex flex-wrap gap-2" aria-label={`${category.title} examples`}>
              {category.examples.map((example) => <li class="rounded-full border border-white/15 bg-white/10 px-3 py-1.5 text-sm font-semibold text-slate-100">{example}</li>)}
            </ul>
            <span class="mt-6 inline-flex font-bold text-yellow-400">{category.action} <span class="ml-2" aria-hidden="true">→</span></span>
          </div>
        </a>
      ))}
    </div>
  </div>
</section>
