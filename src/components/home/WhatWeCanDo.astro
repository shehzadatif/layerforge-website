---
const categories = [
  { title: "Personalized Products", description: "Thoughtful gifts, drinkware, phone cases, plaques, keepsakes, and other items made around your artwork or message.", image: "/images/uv-printing/uv-tumbler.webp", href: "/what-we-make#personalized-products" },
  { title: "Business Branding", description: "Signs, promotional products, workwear, labels, displays, and coordinated items that carry your brand consistently.", image: "/images/solutions/promotional-products.png", href: "/for-businesses" },
  { title: "Apparel, Stickers & Labels", description: "Custom shirts, workwear, transfers, stickers, decals, and labels for people, teams, events, and businesses.", image: "/images/uv-printing/dtf-apparel.webp", href: "/what-we-make#apparel" },
  { title: "3D-Printed Products", description: "Browse proven workshop, tool-storage, automotive, and functional designs. Choose the available options and place your order online.", image: "/images/3d-printing/functional-products.webp", href: "/shop" },
];
---

<section class="bg-white py-24 sm:py-28">
  <div class="mx-auto max-w-7xl px-6">
    <div class="max-w-3xl">
      <p class="text-sm font-bold uppercase tracking-[0.28em] text-yellow-600">What we can help you create</p>
      <h2 class="mt-4 text-4xl font-bold tracking-tight text-slate-950 sm:text-5xl">Start with what you need—not how it is made.</h2>
      <p class="mt-6 text-lg leading-8 text-slate-600">Explore the types of custom work we regularly help with. Every project is reviewed with you before pricing and production are confirmed.</p>
    </div>
    <div class="mt-14 grid gap-6 md:grid-cols-2">
      {categories.map((category) => (
        <a href={category.href} class="group overflow-hidden rounded-3xl border border-slate-200 bg-slate-950 shadow-sm transition duration-300 hover:-translate-y-1 hover:shadow-xl">
          <div class="relative h-72 overflow-hidden"><img src={category.image} alt="" loading="lazy" class="h-full w-full object-cover transition duration-500 group-hover:scale-105" /><div class="absolute inset-0 bg-gradient-to-t from-slate-950 via-slate-950/25 to-transparent"></div></div>
          <div class="p-7 text-white"><h3 class="text-2xl font-bold group-hover:text-yellow-400">{category.title}</h3><p class="mt-3 leading-7 text-slate-300">{category.description}</p><span class="mt-6 inline-flex font-bold text-yellow-400">See how we can help <span class="ml-2" aria-hidden="true">→</span></span></div>
        </a>
      ))}
    </div>
  </div>
</section>
