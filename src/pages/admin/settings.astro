---
import AdminLayout from "../../layouts/AdminLayout.astro";
import { supabaseAdmin } from "../../lib/supabaseAdmin";

const { data, error } = await supabaseAdmin
  .from("settings")
  .select("setting_key, setting_value");

if (error) {
  console.error("Unable to load settings:", error);
}

const settingsMap = new Map(
  (data ?? []).map((row) => [
    row.setting_key,
    row.setting_value ?? "",
  ])
);

const getSetting = (
  key: string,
  fallback = ""
) => settingsMap.get(key) ?? fallback;

const stripeConnected = Boolean(
  import.meta.env.STRIPE_SECRET_KEY
);

const resendConnected = Boolean(
  import.meta.env.RESEND_API_KEY
);

const supabaseConnected = !error;
---

<AdminLayout title="Settings" active="settings">

  <div class="mb-8">
    <h1 class="text-4xl font-bold">
      Settings
    </h1>

    <p class="mt-2 text-slate-500">
      Manage business details and application defaults.
    </p>
  </div>

  <form
    action="/api/admin/update-settings"
    method="POST"
    class="space-y-8"
  >

    <div class="rounded-2xl bg-white p-8 shadow">

      <h2 class="mb-6 text-2xl font-bold">
        Company Information
      </h2>

      <div class="grid gap-6 md:grid-cols-2">

        <div>
          <label class="mb-2 block font-semibold">
            Company Name
          </label>

          <input
            name="company_name"
            value={getSetting("company_name", "Layer Forge Canada")}
            required
            class="w-full rounded-xl border px-4 py-3"
          />
        </div>

        <div>
          <label class="mb-2 block font-semibold">
            Website
          </label>

          <input
            name="website"
            value={getSetting(
              "website",
              "https://layerforgecanada.com"
            )}
            class="w-full rounded-xl border px-4 py-3"
          />
        </div>

        <div>
          <label class="mb-2 block font-semibold">
            Phone
          </label>

          <input
            name="company_phone"
            value={getSetting("company_phone")}
            class="w-full rounded-xl border px-4 py-3"
          />
        </div>

        <div>
          <label class="mb-2 block font-semibold">
            Support Email
          </label>

          <input
            type="email"
            name="support_email"
            value={getSetting("support_email")}
            class="w-full rounded-xl border px-4 py-3"
          />
        </div>

        <div class="md:col-span-2">
          <label class="mb-2 block font-semibold">
            Address
          </label>

          <textarea
            name="company_address"
            rows="4"
            class="w-full rounded-xl border px-4 py-3"
          >{getSetting("company_address")}</textarea>
        </div>

      </div>
    </div>

    <div class="rounded-2xl bg-white p-8 shadow">

      <div class="flex flex-wrap items-start justify-between gap-4">
        <div>
          <h2 class="text-2xl font-bold">
            Bulk Quantity Discounts
          </h2>

          <p class="mt-2 max-w-3xl text-sm leading-6 text-slate-500">
            These tiers apply only to products marked as eligible in the
            product editor. Ineligible products do not count toward a tier and
            remain at their regular price.
          </p>
        </div>

        <label class="flex items-center gap-3 rounded-xl border border-emerald-200 bg-emerald-50 px-5 py-3 font-semibold text-slate-900">
          <input
            type="checkbox"
            name="bulk_discount_enabled"
            checked={getSetting("bulk_discount_enabled", "true") === "true"}
            class="h-5 w-5 accent-emerald-600"
          />
          Enable bulk discounts
        </label>
      </div>

      <div class="mt-8 overflow-hidden rounded-xl border border-slate-200">
        <div class="grid grid-cols-[5rem_1fr_1fr] gap-4 bg-slate-100 px-5 py-3 text-sm font-bold text-slate-700">
          <span>Tier</span>
          <span>Minimum eligible pieces</span>
          <span>Discount percentage</span>
        </div>

        {
          [
            {
              number: 1,
              minimum: "5",
              percentage: "5",
            },
            {
              number: 2,
              minimum: "10",
              percentage: "10",
            },
            {
              number: 3,
              minimum: "20",
              percentage: "15",
            },
          ].map((tier) => (
            <div class="grid grid-cols-[5rem_1fr_1fr] items-center gap-4 border-t border-slate-200 px-5 py-4">
              <span class="font-bold text-slate-900">Tier {tier.number}</span>

              <input
                type="number"
                min="1"
                max="1000"
                step="1"
                required
                name={`bulk_discount_tier_${tier.number}_minimum_quantity`}
                value={getSetting(
                  `bulk_discount_tier_${tier.number}_minimum_quantity`,
                  tier.minimum,
                )}
                aria-label={`Tier ${tier.number} minimum eligible pieces`}
                class="w-full rounded-xl border px-4 py-3"
              />

              <div class="relative">
                <input
                  type="number"
                  min="1"
                  max="50"
                  step="1"
                  required
                  name={`bulk_discount_tier_${tier.number}_percentage`}
                  value={getSetting(
                    `bulk_discount_tier_${tier.number}_percentage`,
                    tier.percentage,
                  )}
                  aria-label={`Tier ${tier.number} discount percentage`}
                  class="w-full rounded-xl border px-4 py-3 pr-10"
                />
                <span class="pointer-events-none absolute right-4 top-1/2 -translate-y-1/2 font-semibold text-slate-500">
                  %
                </span>
              </div>
            </div>
          ))
        }
      </div>

      <p class="mt-4 text-sm leading-6 text-slate-500">
        Tier quantities must increase from top to bottom. Discounts are
        calculated from the combined quantity of eligible products in the
        cart.
      </p>
    </div>

    <div class="rounded-2xl bg-white p-8 shadow">

      <h2 class="mb-6 text-2xl font-bold">
        Email Settings
      </h2>

      <div class="grid gap-6 md:grid-cols-2">

        <div>
          <label class="mb-2 block font-semibold">
            Quote From Email
          </label>

          <input
            type="email"
            name="quote_from_email"
            value={getSetting("quote_from_email")}
            class="w-full rounded-xl border px-4 py-3"
          />
        </div>

        <div>
          <label class="mb-2 block font-semibold">
            Order From Email
          </label>

          <input
            type="email"
            name="order_from_email"
            value={getSetting("order_from_email")}
            class="w-full rounded-xl border px-4 py-3"
          />
        </div>

        <div>
          <label class="mb-2 block font-semibold">
            Reply-To Email
          </label>

          <input
            type="email"
            name="reply_to_email"
            value={getSetting("reply_to_email")}
            class="w-full rounded-xl border px-4 py-3"
          />
        </div>

      </div>
    </div>

    <div class="rounded-2xl bg-white p-8 shadow">

      <h2 class="mb-6 text-2xl font-bold">
        Business Defaults
      </h2>

      <div class="grid gap-6 md:grid-cols-2">

        <div>
          <label class="mb-2 block font-semibold">
            Tax Name
          </label>

          <input
            name="tax_name"
            value={getSetting("tax_name", "GST")}
            class="w-full rounded-xl border px-4 py-3"
          />
        </div>

        <div>
          <label class="mb-2 block font-semibold">
            Default Tax Rate (%)
          </label>

          <input
            type="number"
            step="0.01"
            min="0"
            name="default_tax_rate"
            value={getSetting("default_tax_rate", "0")}
            class="w-full rounded-xl border px-4 py-3"
          />
        </div>

        <div>
          <label class="mb-2 block font-semibold">
            Production Lead Days
          </label>

          <input
            type="number"
            min="0"
            name="production_lead_days"
            value={getSetting(
              "production_lead_days",
              "5"
            )}
            class="w-full rounded-xl border px-4 py-3"
          />
        </div>

        <div>
          <label class="mb-2 block font-semibold">
            Shipping Lead Days
          </label>

          <input
            type="number"
            min="0"
            name="shipping_lead_days"
            value={getSetting(
              "shipping_lead_days",
              "3"
            )}
            class="w-full rounded-xl border px-4 py-3"
          />
        </div>

      </div>
    </div>

    <div class="rounded-2xl bg-white p-8 shadow">

      <h2 class="mb-6 text-2xl font-bold">
        Integrations
      </h2>

      <div class="grid gap-4 md:grid-cols-3">

        <div class="rounded-xl border p-5">
          <div class="font-semibold">
            Stripe
          </div>

          <div class={`mt-2 font-semibold ${
            stripeConnected
              ? "text-green-600"
              : "text-red-600"
          }`}>
            {stripeConnected ? "Connected" : "Missing"}
          </div>
        </div>

        <div class="rounded-xl border p-5">
          <div class="font-semibold">
            Resend
          </div>

          <div class={`mt-2 font-semibold ${
            resendConnected
              ? "text-green-600"
              : "text-red-600"
          }`}>
            {resendConnected ? "Connected" : "Missing"}
          </div>
        </div>

        <div class="rounded-xl border p-5">
          <div class="font-semibold">
            Supabase
          </div>

          <div class={`mt-2 font-semibold ${
            supabaseConnected
              ? "text-green-600"
              : "text-red-600"
          }`}>
            {supabaseConnected ? "Connected" : "Missing"}
          </div>
        </div>

      </div>
    </div>

    <button
      type="submit"
      class="rounded-xl bg-yellow-400 px-8 py-4 font-bold text-slate-950 hover:bg-yellow-300"
    >
      Save Settings
    </button>

  </form>

</AdminLayout>
