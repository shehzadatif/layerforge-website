---
import AdminLayout from "../../../layouts/AdminLayout.astro";
import { getOrder } from "../../../lib/orders";
import { formatPacificDateTime } from "../../../lib/dateUtils";
import {
  formatEstimatedReadyDate,
  formatProductionDuration,
  getOrderProductionDays,
} from "../../../lib/productionEstimate";
import { formatTaxRate } from "../../../lib/taxConfig";
import { estimateShipmentPackagesForItems } from "../../../lib/shippingPackingServer";
import { supabaseAdmin } from "../../../lib/supabaseAdmin";
import {
  APPAREL_ARTWORK_BUCKET,
  APPAREL_PRINT_CLASS_DETAILS,
  getApparelPrintClass,
} from "../../../lib/apparelDesigner";

const { id } = Astro.params;

if (!id) {
  return Astro.redirect("/admin/orders");
}

const order = await getOrder(id);
const orderItems = await Promise.all(
  (order.order_items ?? []).map(async (item: any) => {
    const design = item.design_data;
    if (!design?.sides) return item;

    const artworkUrls: Record<string, string> = {};
    for (const side of ["front", "back"] as const) {
      const path = design.sides?.[side]?.artworkPath;
      if (!path) continue;
      const { data } = await supabaseAdmin.storage
        .from(APPAREL_ARTWORK_BUCKET)
        .createSignedUrl(path, 60 * 60);
      if (data?.signedUrl) artworkUrls[side] = data.signedUrl;
    }

    return { ...item, artwork_urls: artworkUrls };
  }),
);
const gstRate = Number(order.gst_rate ?? 0);
const gstAmount = Number(order.gst_amount ?? 0);
const pstRate = Number(order.pst_rate ?? 0);
const pstAmount = Number(order.pst_amount ?? 0);
const hasTaxBreakdown =
  gstRate > 0 || gstAmount > 0 || pstRate > 0 || pstAmount > 0;

const baseUrl =
  import.meta.env.PUBLIC_SITE_URL
    ?.trim()
    .replace(/\/+$/, "");

if (!baseUrl) {
  throw new Error(
    "Missing PUBLIC_SITE_URL environment variable.",
  );
}

const trackingUrl =
  `${baseUrl}/t/${encodeURIComponent(
    order.tracking_token,
  )}`;

const productionDays = getOrderProductionDays(order.order_items);
const estimatedReadyDate = formatEstimatedReadyDate(
  order.created_at,
  productionDays,
);
const estimatedPackages = await estimateShipmentPackagesForItems(
  (order.order_items ?? []).map(
    (item: { product_id?: string; variant_id?: string; quantity?: number }) => ({
      productId: String(item.product_id ?? ""),
      variantId: String(item.variant_id ?? "") || undefined,
      quantity: Number(item.quantity ?? 0),
    }),
  ),
);
const savedPackages = Array.isArray(order.order_shipping_packages)
  ? [...order.order_shipping_packages].sort(
      (left, right) => Number(left.package_number) - Number(right.package_number),
    )
  : [];
const legacyLabelExists = Boolean(order.stallion_label_path);
const legacyPackage = {
  weight: Number(order.package_weight_lbs ?? estimatedPackages[0]?.weight ?? 0.75),
  length: Number(order.package_length_in ?? estimatedPackages[0]?.length ?? 8),
  width: Number(order.package_width_in ?? estimatedPackages[0]?.width ?? 6),
  height: Number(order.package_height_in ?? estimatedPackages[0]?.height ?? 4),
};
const shippingPackages = savedPackages.length > 0
  ? savedPackages.map((parcel) => ({
      packageNumber: Number(parcel.package_number),
      weight: Number(parcel.weight_lbs),
      length: Number(parcel.length_in),
      width: Number(parcel.width_in),
      height: Number(parcel.height_in),
      trackingNumber: String(parcel.tracking_number ?? ""),
      carrier: String(parcel.shipping_carrier ?? ""),
      serviceName: String(parcel.shipping_service_name ?? ""),
      shipmentCode: String(parcel.stallion_ship_code ?? parcel.stallion_shipment_id ?? ""),
      cost: Number(parcel.label_cost ?? 0),
      hasLabel: Boolean(parcel.label_path),
    }))
  : legacyLabelExists
  ? [{
      packageNumber: 1,
      ...legacyPackage,
      trackingNumber: String(order.shipping_tracking_number ?? ""),
      carrier: String(order.shipping_carrier ?? ""),
      serviceName: String(order.shipping_service_name ?? ""),
      shipmentCode: String(order.stallion_ship_code ?? order.stallion_shipment_id ?? ""),
      cost: Number(order.stallion_label_cost ?? 0),
      hasLabel: true,
    }]
  : estimatedPackages.map((parcel, index) => ({
      packageNumber: index + 1,
      ...parcel,
      trackingNumber: "",
      carrier: "",
      serviceName: "",
      shipmentCode: "",
      cost: 0,
      hasLabel: false,
    }));
const isShippingOrder =
  String(order.delivery_method).toLowerCase() === "shipping";
const hasStallionLabel = shippingPackages.some((parcel) => parcel.hasLabel);
const allPackagesLabelled = shippingPackages.length > 0 && shippingPackages.every((parcel) => parcel.hasLabel);
const shippingService =
  order.shipping_service || "cheapest_tracked";
---

<AdminLayout
  title={`Order ${order.order_number ?? ""}`}
  active="orders"
>

  <!-- Page Header -->

  <div class="mb-8 flex flex-col gap-4 sm:flex-row sm:items-center sm:justify-between">

    <div>

      <h1 class="text-4xl font-bold">
        {"LF" + String(order.order_number).padStart(6, "0")}
      </h1>

      <p class="mt-2 text-slate-500">
        Placed on {formatPacificDateTime(order.created_at)}
      </p>

    </div>

    <div class="flex flex-col gap-3 sm:flex-row">
      {
        order.payment_status === "Paid" && (
          <>
            <a
              href={`/api/admin/orders/${order.id}/invoice`}
              target="_blank"
              rel="noopener noreferrer"
              class="rounded-xl border border-slate-300 bg-white px-5 py-3 text-center font-semibold text-slate-800 hover:bg-slate-100"
            >
              View Invoice
            </a>
            <a
              href={`/api/admin/orders/${order.id}/invoice?download=1`}
              class="rounded-xl bg-yellow-400 px-5 py-3 text-center font-semibold text-slate-950 hover:bg-yellow-300"
            >
              Download Invoice
            </a>
          </>
        )
      }

      <a
        href="/admin/orders"
        class="rounded-xl bg-slate-900 px-5 py-3 text-center font-semibold text-white hover:bg-slate-700"
      >
        ← Back to Orders
      </a>
    </div>

  </div>

  <!-- Customer Tracking -->

  <div class="mb-8 rounded-2xl border border-blue-200 bg-blue-50 p-6">

    <h2 class="mb-4 text-xl font-bold text-blue-700">
      Customer Tracking
    </h2>

    <div class="mb-4 break-all rounded-lg bg-white p-3 font-mono text-sm">
      {trackingUrl}
    </div>

    <a
      href={trackingUrl}
      target="_blank"
      rel="noopener noreferrer"
      class="inline-block rounded-lg bg-green-600 px-5 py-2 font-semibold text-white hover:bg-green-700"
    >
      🌐 Open Tracking Page
    </a>

  </div>

  <!-- Production Estimate -->

  <div class="mb-8 rounded-2xl border border-yellow-300 bg-yellow-50 p-6">
    <div class="flex flex-col gap-6 lg:flex-row lg:items-end lg:justify-between">
      <div>
        <h2 class="text-xl font-bold text-slate-950">
          Customer Production Estimate
        </h2>
        <p class="mt-2 text-slate-600">
          {
            estimatedReadyDate
              ? `${formatProductionDuration(productionDays)} · Estimated ${String(order.delivery_method).toLowerCase() === "pickup" ? "pickup" : "ready to ship"}: ${estimatedReadyDate}`
              : "No production estimate is currently shown to the customer."
          }
        </p>
      </div>

      <div class="flex flex-col gap-3 sm:flex-row sm:items-end">
        <label class="block">
          <span class="mb-2 block text-sm font-semibold text-slate-700">
            Business days
          </span>
          <input
            id="productionDays"
            type="number"
            min="1"
            max="365"
            value={productionDays || 5}
            class="w-full rounded-lg border border-slate-300 bg-white px-4 py-3 sm:w-36"
          />
        </label>

        <button
          type="button"
          onclick="saveProductionEstimate()"
          class="rounded-lg bg-yellow-400 px-5 py-3 font-semibold text-slate-950 hover:bg-yellow-300"
        >
          Save Estimate
        </button>
      </div>
    </div>
  </div>

  <!-- Customer, Delivery and Status -->

  <div class="grid gap-8 lg:grid-cols-3">

    <!-- Customer -->

    <div class="rounded-2xl bg-white p-8 shadow">

      <h2 class="mb-6 text-2xl font-bold">
        Customer
      </h2>

      <div class="space-y-3">

        <p>
          <span class="font-semibold">Name:</span><br />
          {order.customer_name || "-"}
        </p>

        <p>
          <span class="font-semibold">Email:</span><br />
          {order.email || "-"}
        </p>

        <p>
          <span class="font-semibold">Phone:</span><br />
          {order.phone || "-"}
        </p>

      </div>

    </div>

    <!-- Delivery -->

    <div class="rounded-2xl bg-white p-8 shadow">

      <h2 class="mb-6 text-2xl font-bold">
        Delivery
      </h2>

      <div class="space-y-3">

        <p>
          <span class="font-semibold">Method:</span><br />
          {order.delivery_method || "-"}
        </p>

        <p>
          <span class="font-semibold">Address:</span><br />
          {order.shipping_address || "-"}
        </p>

        {
          order.unit && (
            <p>
              <span class="font-semibold">Unit:</span><br />
              {order.unit}
            </p>
          )
        }

        <p>
          {[order.city, order.province]
            .filter(Boolean)
            .join(", ") || "-"}
        </p>

        <p>
          {order.postal_code || "-"}
        </p>

      </div>

    </div>

    <!-- Status -->

    <div class="rounded-2xl bg-white p-8 shadow">

      <h2 class="mb-6 text-2xl font-bold">
        Status
      </h2>

      <div class="space-y-6">

        <div>

          <div class="mb-2 text-sm text-slate-500">
            Payment
          </div>

          <span
            class={`rounded-full px-4 py-2 font-semibold ${
              order.payment_status === "Paid"
                ? "bg-green-100 text-green-700"
                : "bg-yellow-100 text-yellow-700"
            }`}
          >
            {order.payment_status}
          </span>

        </div>

        <div>

          <div class="mb-2 text-sm text-slate-500">
            Production
          </div>

          <span
            class={`rounded-full px-4 py-2 font-semibold ${
              order.order_status === "New"
                ? "bg-yellow-100 text-yellow-700"
                : order.order_status === "In Progress"
                ? "bg-blue-100 text-blue-700"
                : order.order_status === "Ready"
                ? "bg-green-100 text-green-700"
                : order.order_status === "Shipped"
                ? "bg-indigo-100 text-indigo-700"
                : order.order_status === "Completed"
                ? "bg-emerald-100 text-emerald-700"
                : order.order_status === "Cancelled"
                ? "bg-red-100 text-red-700"
                : "bg-slate-100 text-slate-700"
            }`}
          >
            {order.order_status}
          </span>

        </div>

        <hr />

        <div>

          <h3 class="mb-4 font-semibold">
            Update Status
          </h3>

          <div class="grid grid-cols-2 gap-3">

            <button
              type="button"
              onclick="updateStatus('New')"
              class="rounded-lg bg-yellow-400 px-4 py-3 font-semibold text-slate-950 hover:bg-yellow-300"
            >
              🆕 New
            </button>

            <button
              type="button"
              onclick="updateStatus('In Progress')"
              class="rounded-lg bg-blue-600 px-4 py-3 font-semibold text-white hover:bg-blue-700"
            >
              🔨 In Progress
            </button>

            <button
              type="button"
              onclick="updateStatus('Ready')"
              class="rounded-lg bg-green-600 px-4 py-3 font-semibold text-white hover:bg-green-700"
            >
              📦 Ready
            </button>

            <button
              type="button"
              onclick="updateStatus('Shipped')"
              class="rounded-lg bg-indigo-600 px-4 py-3 font-semibold text-white hover:bg-indigo-700"
            >
              🚚 Shipped
            </button>

            <button
              type="button"
              onclick="updateStatus('Completed')"
              class="rounded-lg bg-emerald-700 px-4 py-3 font-semibold text-white hover:bg-emerald-800"
            >
              ✅ Completed
            </button>

            <button
              type="button"
              onclick="updateStatus('Cancelled')"
              class="rounded-lg bg-red-600 px-4 py-3 font-semibold text-white hover:bg-red-700"
            >
              ❌ Cancelled
            </button>

          </div>

        </div>

      </div>

    </div>

  </div>

  <!-- Internal Notes -->

  <div class="mt-8 rounded-2xl bg-white p-8 shadow">

    <div class="mb-6 flex flex-col gap-4 sm:flex-row sm:items-center sm:justify-between">

      <h2 class="text-2xl font-bold">
        Internal Notes
      </h2>

      <button
        type="button"
        onclick="saveNotes()"
        class="rounded-lg bg-yellow-400 px-5 py-2 font-semibold text-slate-950 hover:bg-yellow-300"
      >
        💾 Save Notes
      </button>

    </div>

    <textarea
      id="orderNotes"
      rows="6"
      class="w-full rounded-xl border p-4"
      placeholder="Internal production notes..."
    >{order.notes ?? ""}</textarea>

  </div>

  <!-- Products -->

  <div class="mt-8 overflow-x-auto rounded-2xl bg-white p-8 shadow">

    <h2 class="mb-6 text-2xl font-bold">
      Products
    </h2>

    <table class="min-w-full">

      <thead>

        <tr class="border-b">

          <th class="pb-4 text-left">
            Product
          </th>

          <th class="pb-4 text-left">
            Material
          </th>

          <th class="pb-4 text-center">
            Qty
          </th>

          <th class="pb-4 text-center">
            Production
          </th>

          <th class="pb-4 text-right">
            Unit Price
          </th>

          <th class="pb-4 text-right">
            Total
          </th>

        </tr>

      </thead>

      <tbody>

        {
          orderItems.length > 0 ? (
            orderItems.map((item: any) => (

              <tr class="border-b">

                <td class="py-4">
                  {item.product_name}
                  {
                    item.variant_name && (
                      <div class="mt-1 text-sm text-slate-500">
                        Variant: {item.variant_name}
                      </div>
                    )
                  }
                  {
                    item.design_data && (
                      <div class="mt-3 rounded-xl border border-yellow-200 bg-yellow-50 p-4 text-sm text-slate-700">
                        <div class="font-bold text-slate-950">Custom apparel production details</div>
                        <div class="mt-2 flex flex-wrap gap-x-4 gap-y-1">
                          <span>Garment: <strong>{item.design_data.garmentType === "hoodie" ? "Hoodie" : "T-Shirt"}</strong></span>
                          <span>Size: <strong>{item.design_data.size}</strong></span>
                          <span class="inline-flex items-center gap-1.5">
                            Colour:
                            <span
                              class="inline-block h-4 w-4 rounded-full border border-slate-400"
                              style={`background:${item.design_data.colorHex}`}
                            ></span>
                            <strong>{item.design_data.colorName}</strong>
                          </span>
                          <span>Quality: <strong>{item.design_data.quality}</strong></span>
                        </div>
                        <div class="mt-3 grid gap-2 sm:grid-cols-2">
                          {
                            (["front", "back"] as const).map((side) => {
                              const artwork = item.design_data.sides?.[side];
                              if (!artwork) return null;
                              return (
                                <div class="rounded-lg border border-yellow-200 bg-white p-3">
                                  <div class="font-bold capitalize text-slate-950">{side}</div>
                                  <div class="mt-1 text-xs leading-5 text-slate-600">
                                    <strong>{APPAREL_PRINT_CLASS_DETAILS[getApparelPrintClass(artwork)].label}</strong><br />
                                    {Number(artwork.widthIn).toFixed(1)} × {Number(artwork.heightIn).toFixed(1)} in<br />
                                    Position: {Number(artwork.xPercent).toFixed(0)}% horizontal, {Number(artwork.yPercent).toFixed(0)}% vertical
                                  </div>
                                  {
                                    item.artwork_urls?.[side] && (
                                      <a
                                        href={item.artwork_urls[side]}
                                        target="_blank"
                                        rel="noopener noreferrer"
                                        download
                                        class="mt-2 inline-block font-bold text-blue-700 underline"
                                      >
                                        Download original artwork
                                      </a>
                                    )
                                  }
                                </div>
                              );
                            })
                          }
                        </div>
                      </div>
                    )
                  }
                </td>

                <td class="py-4">
                  {item.material || "-"}
                </td>

                <td class="py-4 text-center">
                  {item.quantity}
                </td>

                <td class="py-4 text-center">
                  {
                    Number(item.production_days ?? 0) > 0
                      ? formatProductionDuration(item.production_days)
                      : "-"
                  }
                </td>

                <td class="py-4 text-right">
                  CAD ${Number(item.unit_price).toFixed(2)}
                </td>

                <td class="py-4 text-right font-semibold">
                  CAD ${Number(item.total_price).toFixed(2)}
                </td>

              </tr>

            ))
          ) : (
            <tr>
              <td
                colspan="6"
                class="py-8 text-center text-slate-500"
              >
                No products found.
              </td>
            </tr>
          )
        }

      </tbody>

    </table>

  </div>

  <!-- Totals -->

  <div class="mt-8 ml-auto w-full max-w-md rounded-2xl bg-white p-8 shadow">

    <div class="mb-4 flex justify-between">
      <span>Subtotal</span>

      <span>
        CAD ${Number(order.subtotal ?? 0).toFixed(2)}
      </span>
    </div>

    <div class="mb-4 flex justify-between">
      <span>Shipping</span>

      <span>
        CAD ${Number(order.shipping ?? 0).toFixed(2)}
      </span>
    </div>

    {
      hasTaxBreakdown ? (
        <>
          {(gstRate > 0 || gstAmount > 0) && (
            <div class="mb-4 flex justify-between">
              <span>GST ({formatTaxRate(gstRate)}%)</span>
              <span>CAD ${gstAmount.toFixed(2)}</span>
            </div>
          )}

          {(pstRate > 0 || pstAmount > 0) && (
            <div class="mb-4 flex justify-between">
              <span>PST ({formatTaxRate(pstRate)}%)</span>
              <span>CAD ${pstAmount.toFixed(2)}</span>
            </div>
          )}
        </>
      ) : (
        <div class="mb-4 flex justify-between">
          <span>Tax</span>
          <span>CAD ${Number(order.tax ?? 0).toFixed(2)}</span>
        </div>
      )
    }

    <hr class="my-6" />

    <div class="flex justify-between text-2xl font-bold">
      <span>Total</span>

      <span>
        CAD ${Number(order.total ?? 0).toFixed(2)}
      </span>
    </div>

  </div>

  <!-- Stallion Labels -->

  {
    order.payment_status === "Paid" && isShippingOrder && (
      <div class="mt-8 rounded-2xl border border-yellow-300 bg-yellow-50 p-8 shadow">
        <div class="flex flex-col gap-6 lg:flex-row lg:items-start lg:justify-between">
          <div>
            <h2 class="text-2xl font-bold text-slate-950">Stallion Shipping Labels</h2>
            <p class="mt-2 max-w-3xl text-slate-600">
              Use one row for every physical box. Each box receives its own label
              and tracking number. Confirm the packed measurements before purchase.
            </p>
          </div>
          {hasStallionLabel && (
            <a
              href={`/api/admin/orders/${order.id}/stallion-label`}
              target="_blank"
              rel="noopener noreferrer"
              class="rounded-xl bg-slate-900 px-6 py-3 text-center font-semibold text-white hover:bg-slate-700"
            >
              Print All Labels
            </a>
          )}
        </div>

        <div id="stallionPackages" class="mt-6 space-y-4">
          {shippingPackages.map((parcel) => (
            <div class="stallion-package rounded-xl border border-slate-200 bg-white p-5" data-labelled={String(parcel.hasLabel)}>
              <div class="mb-4 flex items-center justify-between gap-3">
                <h3 class="font-bold text-slate-950">
                  Package <span class="package-number">{parcel.packageNumber}</span> of <span class="package-total">{shippingPackages.length}</span>
                </h3>
                {!hasStallionLabel && shippingPackages.length > 1 && (
                  <button type="button" class="remove-package text-sm font-semibold text-red-700 hover:text-red-900">
                    Remove box
                  </button>
                )}
              </div>
              <div class="grid gap-4 sm:grid-cols-2 lg:grid-cols-4">
                {([[
                  "weight", "Weight (lb)", parcel.weight
                ], [
                  "length", "Length (in)", parcel.length
                ], [
                  "width", "Width (in)", parcel.width
                ], [
                  "height", "Height (in)", parcel.height
                ]] as const).map(([field, label, value]) => (
                  <label class="block">
                    <span class="mb-2 block text-sm font-semibold text-slate-700">{label}</span>
                    <input
                      class={`package-${field} w-full rounded-lg border border-slate-300 px-4 py-3 ${parcel.hasLabel ? "bg-slate-100" : "bg-white"}`}
                      type="number"
                      min="0.1"
                      max="200"
                      step="0.01"
                      value={value}
                      readonly={parcel.hasLabel}
                    />
                  </label>
                ))}
              </div>
              {parcel.hasLabel && (
                <div class="mt-4 grid gap-3 border-t border-slate-200 pt-4 text-sm md:grid-cols-4">
                  <div><span class="text-slate-500">Service</span><div class="font-semibold">{parcel.serviceName || order.shipping_service_name || order.shipping_service}</div></div>
                  <div><span class="text-slate-500">Tracking</span><div class="font-semibold">{parcel.trackingNumber || "-"}</div></div>
                  <div><span class="text-slate-500">Shipment</span><div class="font-semibold">{parcel.shipmentCode || "-"}</div></div>
                  <div class="flex items-end justify-between gap-3">
                    <div><span class="text-slate-500">Cost</span><div class="font-semibold">CAD ${parcel.cost.toFixed(2)}</div></div>
                    <a href={`/api/admin/orders/${order.id}/stallion-label?package=${parcel.packageNumber}`} target="_blank" rel="noopener noreferrer" class="font-semibold text-blue-700 hover:text-blue-900">Print</a>
                  </div>
                </div>
              )}
            </div>
          ))}
        </div>

        {!hasStallionLabel && (
          <button id="addStallionPackageButton" type="button" class="mt-4 rounded-lg border border-slate-400 bg-white px-4 py-2 font-semibold text-slate-800 hover:bg-slate-100">
            + Add another box
          </button>
        )}

        {!allPackagesLabelled && (
          <>
            <label class="mt-5 block max-w-md">
              <span class="mb-2 block font-semibold text-slate-700">Shipping service</span>
              <input id="stallionService" value={shippingService} readonly={Boolean(order.shipping_service)} class="w-full rounded-lg border border-slate-300 bg-white px-4 py-3 read-only:bg-slate-100" />
            </label>
            {!order.shipping_service && (
              <p class="mt-3 text-sm text-amber-800">
                This older order has no saved checkout service. Layerforge will purchase the cheapest currently available tracked service.
              </p>
            )}
            <div class="mt-6 flex flex-col gap-3 sm:flex-row sm:items-center">
              <button id="createStallionLabelButton" type="button" onclick="purchaseStallionLabel()" class="rounded-xl bg-yellow-400 px-7 py-4 font-semibold text-slate-950 hover:bg-yellow-300 disabled:cursor-wait disabled:opacity-60">
                {hasStallionLabel ? "Purchase Remaining Labels" : `Purchase & Print ${shippingPackages.length} ${shippingPackages.length === 1 ? "Label" : "Labels"}`}
              </button>
              <p id="stallionLabelStatus" class="text-sm text-slate-600" aria-live="polite"></p>
            </div>
          </>
        )}
      </div>
    )
  }

  <!-- Shipping Details -->

  <div class="mt-8 rounded-2xl bg-white p-8 shadow">

    <h2 class="mb-2 text-2xl font-bold">
      Shipping Details
    </h2>

    <p class="mb-6 text-slate-500">
      Enter the carrier information and notify the customer when the order ships.
    </p>

    <div class="grid gap-6 md:grid-cols-2">

      <div>

        <label
          for="shippingCarrier"
          class="mb-2 block font-semibold"
        >
          Carrier
        </label>

        <input
          id="shippingCarrier"
          value={order.shipping_carrier ?? ""}
          class="w-full rounded-lg border px-4 py-3"
          placeholder="Carrier name"
        />

      </div>

      <div>

        <label
          for="trackingNumber"
          class="mb-2 block font-semibold"
        >
          Tracking Number
        </label>

        <input
          id="trackingNumber"
          value={order.shipping_tracking_number ?? ""}
          class="w-full rounded-lg border px-4 py-3"
          placeholder="Enter tracking number"
        />

      </div>

    </div>

    <div class="mt-6">

      <label
        for="trackingUrl"
        class="mb-2 block font-semibold"
      >
        Carrier Tracking URL
      </label>

      <input
        id="trackingUrl"
        type="url"
        value={order.shipping_tracking_url ?? ""}
        class="w-full rounded-lg border px-4 py-3"
        placeholder="https://..."
      />

    </div>

    {
      order.shipped_at && (
        <div class="mt-6 rounded-xl bg-green-50 p-4 text-green-700">
          Shipped on {formatPacificDateTime(order.shipped_at)}
        </div>
      )
    }

    <button
      type="button"
      onclick="markOrderShipped()"
      class="mt-8 rounded-xl bg-green-600 px-8 py-4 font-semibold text-white hover:bg-green-700"
    >
      🚚 Mark as Shipped and Email Customer
    </button>

  </div>

  <script define:vars={{ orderId: order.id }}>

    window.updateStatus = async function (status) {
      try {
        const response = await fetch(
          "/api/admin/update-order-status",
          {
            method: "POST",
            headers: {
              "Content-Type": "application/json",
            },
            body: JSON.stringify({
              orderId,
              status,
            }),
          }
        );

        const result = await response.json();

        if (!response.ok || !result.success) {
          alert(
            result.error ||
            "Unable to update status."
          );

          return;
        }

        location.reload();
      } catch (error) {
        console.error(error);
        alert("Unable to update status.");
      }
    };

    window.saveNotes = async function () {
      try {
        const notesElement =
          document.getElementById("orderNotes");

        const notes =
          notesElement?.value ?? "";

        const response = await fetch(
          "/api/admin/update-order-notes",
          {
            method: "POST",
            headers: {
              "Content-Type": "application/json",
            },
            body: JSON.stringify({
              orderId,
              notes,
            }),
          }
        );

        const result = await response.json();

        if (!response.ok || !result.success) {
          alert(
            result.error ||
            "Unable to save notes."
          );

          return;
        }

        alert("Notes saved.");
      } catch (error) {
        console.error(error);
        alert("Unable to save notes.");
      }
    };

    window.saveProductionEstimate = async function () {
      try {
        const productionDaysElement =
          document.getElementById("productionDays");

        const productionDays = Number(
          productionDaysElement?.value ?? 0
        );

        if (
          !Number.isInteger(productionDays) ||
          productionDays < 1 ||
          productionDays > 365
        ) {
          alert("Enter production days between 1 and 365.");
          return;
        }

        const response = await fetch(
          "/api/admin/update-order-production-estimate",
          {
            method: "POST",
            headers: {
              "Content-Type": "application/json",
            },
            body: JSON.stringify({
              orderId,
              productionDays,
            }),
          }
        );

        const result = await response.json();

        if (!response.ok || !result.success) {
          alert(result.error || "Unable to save production estimate.");
          return;
        }

        alert("Production estimate updated.");
        location.reload();
      } catch (error) {
        console.error(error);
        alert("Unable to save production estimate.");
      }
    };

    window.markOrderShipped = async function () {
      try {
        const carrierElement =
          document.getElementById(
            "shippingCarrier"
          );

        const trackingNumberElement =
          document.getElementById(
            "trackingNumber"
          );

        const trackingUrlElement =
          document.getElementById(
            "trackingUrl"
          );

        const carrier =
          carrierElement?.value.trim() ?? "";

        const trackingNumber =
          trackingNumberElement?.value.trim() ?? "";

        const trackingUrl =
          trackingUrlElement?.value.trim() ?? "";

        if (!carrier || !trackingNumber) {
          alert(
            "Carrier and tracking number are required."
          );

          return;
        }

        const response = await fetch(
          "/api/admin/mark-order-shipped",
          {
            method: "POST",
            headers: {
              "Content-Type": "application/json",
            },
            body: JSON.stringify({
              orderId,
              carrier,
              trackingNumber,
              trackingUrl,
            }),
          }
        );

        const result = await response.json();

        if (!response.ok || !result.success) {
          alert(
            result.error ||
            "Unable to save shipping details."
          );

          return;
        }

        alert(
          "Order marked as shipped and the customer was notified."
        );

        location.reload();
      } catch (error) {
        console.error(error);

        alert(
          "Unable to save shipping details."
        );
      }
    };

    function updatePackageNumbers() {
      const rows = [...document.querySelectorAll(".stallion-package")];
      rows.forEach((row, index) => {
        row.querySelector(".package-number").textContent = String(index + 1);
        row.querySelector(".package-total").textContent = String(rows.length);
      });
      const button = document.getElementById("createStallionLabelButton");
      if (button && !rows.some((row) => row.dataset.labelled === "true")) {
        button.textContent = `Purchase & Print ${rows.length} ${rows.length === 1 ? "Label" : "Labels"}`;
      }
      document.querySelectorAll(".remove-package").forEach((removeButton) => {
        removeButton.hidden = rows.length <= 1;
      });
    }

    document.getElementById("addStallionPackageButton")?.addEventListener("click", () => {
      const container = document.getElementById("stallionPackages");
      const source = container?.querySelector(".stallion-package:last-child");
      if (!container || !source || container.children.length >= 20) return;
      const copy = source.cloneNode(true);
      copy.dataset.labelled = "false";
      copy.querySelector(".remove-package")?.removeAttribute("hidden");
      copy.querySelector("[class*='border-t']")?.remove();
      container.appendChild(copy);
      updatePackageNumbers();
    });

    document.getElementById("stallionPackages")?.addEventListener("click", (event) => {
      const button = event.target.closest(".remove-package");
      if (!button) return;
      const rows = document.querySelectorAll(".stallion-package");
      if (rows.length > 1) button.closest(".stallion-package")?.remove();
      updatePackageNumbers();
    });

    window.purchaseStallionLabel = async function () {
      const service = document.getElementById("stallionService")?.value.trim() ?? "";
      const packages = [...document.querySelectorAll(".stallion-package")].map((row) => ({
        weight: Number(row.querySelector(".package-weight")?.value ?? 0),
        length: Number(row.querySelector(".package-length")?.value ?? 0),
        width: Number(row.querySelector(".package-width")?.value ?? 0),
        height: Number(row.querySelector(".package-height")?.value ?? 0),
      }));

      if (!service || packages.length === 0 || packages.some((parcel) =>
        [parcel.weight, parcel.length, parcel.width, parcel.height].some(
          (value) => !Number.isFinite(value) || value <= 0,
        ))) {
        alert("Enter valid measurements for every package and select a shipping service.");
        return;
      }

      if (
        !confirm(
          `Purchase ${packages.length} Stallion ${packages.length === 1 ? "label" : "labels"} now? The postage cost for every box will be deducted from your Stallion balance.`,
        )
      ) {
        return;
      }

      const printWindow = window.open("about:blank", "_blank");
      const button = document.getElementById("createStallionLabelButton");
      const status = document.getElementById("stallionLabelStatus");

      if (button) button.disabled = true;
      if (status) status.textContent = `Creating ${packages.length} ${packages.length === 1 ? "shipment" : "shipments"} and purchasing labels…`;

      try {
        const response = await fetch(
          `/api/admin/orders/${encodeURIComponent(orderId)}/stallion-label`,
          {
            method: "POST",
            headers: { "Content-Type": "application/json" },
            body: JSON.stringify({ packages, service }),
          },
        );
        const result = await response.json();

        if (!response.ok || !result.success) {
          printWindow?.close();
          alert(result.error || "Unable to create the Stallion labels.");
          return;
        }

        if (printWindow) {
          printWindow.opener = null;
          printWindow.location.href = result.labelUrl;
        } else {
          window.location.href = result.labelUrl;
          return;
        }

        if (status) {
          status.textContent = `${result.packageCount} ${result.packageCount === 1 ? "label" : "labels"} ready · ${result.carrier}`;
        }

        alert(
          `${result.packageCount} ${result.packageCount === 1 ? "label was" : "labels were"} created. The printable PDF opened in a new tab.`,
        );
        location.reload();
      } catch (error) {
        console.error(error);
        printWindow?.close();
        alert("Unable to create the Stallion labels.");
      } finally {
        if (button) button.disabled = false;
      }
    };

  </script>

</AdminLayout>
