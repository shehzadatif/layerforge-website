---
import AdminLayout from "../../layouts/AdminLayout.astro";
import { supabaseAdmin } from "../../lib/supabaseAdmin";

const { data: products, error } = await supabaseAdmin
  .from("products")
  .select(`
    id, name, sku, status, apparel_back_print_price, created_at,
    product_variants(id, apparel_garment_type, apparel_quality, apparel_color_name, apparel_size, inventory_quantity, price)
  `)
  .eq("apparel_designer_enabled", true)
  .order("created_at", { ascending: false });

if (error) console.error("Unable to load apparel products.", error);

const rows = (products ?? []).map((product) => {
  const variants = (product.product_variants ?? []).filter((variant) => variant.apparel_garment_type);
  return {
    ...product,
    variants,
    stock: variants.reduce((total, variant) => total + Number(variant.inventory_quantity ?? 0), 0),
    lowStock: variants.filter((variant) => Number(variant.inventory_quantity ?? 0) <= 2).length,
    garmentTypes: [...new Set(variants.map((variant) => variant.apparel_garment_type === "hoodie" ? "Hoodie" : "T-Shirt"))],
  };
});
---

<AdminLayout title="Apparel Products" active="apparel">
  <div class="mb-8 flex flex-wrap items-start justify-between gap-4">
    <div>
      <h1 class="text-4xl font-bold text-slate-950">T-Shirts & Hoodies</h1>
      <p class="mt-2 text-slate-500">Manage garment styles, qualities, colours, sizes, prices and on-hand inventory.</p>
    </div>
    <a href="/admin/products/new?apparel=1" class="rounded-lg bg-yellow-400 px-6 py-3 font-bold text-slate-950 hover:bg-yellow-300">+ Add Apparel Product</a>
  </div>

  <div class="grid gap-5 md:grid-cols-3">
    <div class="rounded-2xl bg-white p-5 shadow"><div class="text-sm font-semibold text-slate-500">Apparel products</div><div class="mt-2 text-3xl font-black">{rows.length}</div></div>
    <div class="rounded-2xl bg-white p-5 shadow"><div class="text-sm font-semibold text-slate-500">Inventory combinations</div><div class="mt-2 text-3xl font-black">{rows.reduce((sum, row) => sum + row.variants.length, 0)}</div></div>
    <div class="rounded-2xl bg-white p-5 shadow"><div class="text-sm font-semibold text-slate-500">Total units in stock</div><div class="mt-2 text-3xl font-black">{rows.reduce((sum, row) => sum + row.stock, 0)}</div></div>
  </div>

  <div class="mt-8 overflow-hidden rounded-2xl bg-white shadow">
    {rows.length ? (
      <table class="min-w-full">
        <thead class="bg-slate-100"><tr><th class="px-6 py-4 text-left">Product</th><th class="px-6 py-4 text-left">Garment</th><th class="px-6 py-4 text-right">Combinations</th><th class="px-6 py-4 text-right">Units</th><th class="px-6 py-4 text-center">Status</th><th class="px-6 py-4 text-right">Action</th></tr></thead>
        <tbody>{rows.map((product) => (
          <tr class="border-t hover:bg-slate-50">
            <td class="px-6 py-4"><div class="font-bold text-slate-950">{product.name}</div><div class="mt-1 font-mono text-xs text-slate-500">{product.sku}</div>{product.lowStock > 0 && <div class="mt-1 text-xs font-semibold text-amber-700">{product.lowStock} low/out-of-stock combination{product.lowStock === 1 ? "" : "s"}</div>}</td>
            <td class="px-6 py-4">{product.garmentTypes.join(" + ") || "Not configured"}</td>
            <td class="px-6 py-4 text-right font-semibold">{product.variants.length}</td>
            <td class="px-6 py-4 text-right font-semibold">{product.stock}</td>
            <td class="px-6 py-4 text-center"><span class:list={["rounded-full px-3 py-1 text-xs font-bold", product.status === "Active" ? "bg-emerald-100 text-emerald-800" : "bg-slate-200 text-slate-700"]}>{product.status}</span></td>
            <td class="px-6 py-4 text-right"><a href={`/admin/products/${product.id}?apparel=1`} class="rounded-lg bg-slate-950 px-4 py-2 font-semibold text-white hover:bg-slate-700">Manage</a></td>
          </tr>
        ))}</tbody>
      </table>
    ) : (
      <div class="px-6 py-16 text-center"><div class="text-5xl">👕</div><h2 class="mt-4 text-2xl font-bold">No apparel products yet</h2><p class="mt-2 text-slate-500">Create your first T-shirt or hoodie product and add its inventory combinations.</p><a href="/admin/products/new?apparel=1" class="mt-6 inline-block rounded-lg bg-yellow-400 px-6 py-3 font-bold">Add Apparel Product</a></div>
    )}
  </div>
</AdminLayout>
