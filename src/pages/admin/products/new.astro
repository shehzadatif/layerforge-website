---
import AdminLayout from "../../../layouts/AdminLayout.astro";
import ProductVariantsField from "../../../components/admin/ProductVariantsField.astro";
import { supabaseAdmin } from "../../../lib/supabaseAdmin";

const { data: categories } = await supabaseAdmin
  .from("categories")
  .select("id, name, parent_id")
  .order("name");

const categoryList = categories ?? [];
const parentCategories = categoryList.filter((category) => !category.parent_id);
const childrenByParent = new Map<string, typeof categoryList>();

for (const category of categoryList) {
  if (!category.parent_id) continue;

  const children = childrenByParent.get(category.parent_id) ?? [];
  children.push(category);
  childrenByParent.set(category.parent_id, children);
}

const { data: materials } = await supabaseAdmin
  .from("materials")
  .select("*")
  .eq("active", true)
  .order("sort_order");
---

<AdminLayout title="Add Product" active="products">
  <div class="mb-8">
    <h1 class="text-4xl font-bold">
      Add Product
    </h1>

    <p class="mt-2 text-slate-500">
      Create a new product.
    </p>
  </div>

  <form
    action="/api/admin/products"
    method="POST"
    enctype="multipart/form-data"
  >
    <div class="grid gap-8 lg:grid-cols-2 lg:items-start">
      <section class="rounded-2xl bg-white p-8 shadow">
        <h2 class="mb-6 text-2xl font-bold">Product Information</h2>
        <div class="space-y-6">
    <div>
      <label
        for="name"
        class="mb-2 block font-semibold"
      >
        Product Name
      </label>

      <input
        id="name"
        name="name"
        required
        class="w-full rounded-lg border p-3"
      />
    </div>

    <div>
      <label
        for="brand"
        class="mb-2 block font-semibold"
      >
        Brand (Optional)
      </label>

      <input
        id="brand"
        name="brand"
        maxlength="80"
        placeholder="e.g. Bosch, Milwaukee, DEWALT"
        class="w-full rounded-lg border p-3"
      />

      <p class="mt-2 text-sm text-slate-500">
        Customers can use this value to filter products in the Shop.
      </p>
    </div>

    <div>
      <label
        for="category_id"
        class="mb-2 block font-semibold"
      >
        Category
      </label>

      <select
        id="category_id"
        name="category_id"
        required
        class="w-full rounded-lg border p-3"
      >
        {
          parentCategories.flatMap((parent) => [
            <option value={parent.id}>{parent.name}</option>,
            ...(childrenByParent.get(parent.id) ?? []).map((child) => (
              <option value={child.id}>
                {parent.name} → {child.name}
              </option>
            )),
          ])
        }
      </select>
    </div>

    <div>
      <label
        for="short_description"
        class="mb-2 block font-semibold"
      >
        Short Description
      </label>

      <textarea
        id="short_description"
        name="short_description"
        rows="3"
        class="w-full rounded-lg border p-3"
      ></textarea>
    </div>

    <div>
      <label
        for="description"
        class="mb-2 block font-semibold"
      >
        Description
      </label>

      <textarea
        id="description"
        name="description"
        rows="12"
        placeholder={`Write a short introduction here.

## Features
- First feature
- Second feature

## Installation
1. First step
2. Second step`}
        class="w-full rounded-lg border p-3"
      ></textarea>

      <p class="mt-2 text-sm leading-6 text-slate-500">
        Formatting supported: use a blank line for a new paragraph,
        <code class="rounded bg-slate-100 px-1.5 py-0.5">## Heading</code>,
        <code class="rounded bg-slate-100 px-1.5 py-0.5">- Bullet point</code>,
        or <code class="rounded bg-slate-100 px-1.5 py-0.5">1. Numbered step</code>.
        HTML is not required.
      </p>
    </div>

   <div class="grid gap-6 md:grid-cols-2">
  <div class="flex flex-col">
    <label
      for="price"
      class="mb-2 block font-semibold"
    >
      Base Price (PLA)
    </label>

    <p class="mb-2 min-h-10 text-sm text-slate-500">
      Prices for other materials are calculated automatically
      from this base price.
    </p>

    <input
      id="price"
      type="number"
      name="price"
      min="0.01"
      step="0.01"
      required
      class="w-full rounded-lg border p-3"
    />
  </div>

  <div class="flex flex-col">
    <label
      for="sale_price"
      class="mb-2 block font-semibold"
    >
      Sale Price (Optional)
    </label>

    <p class="mb-2 min-h-10 text-sm text-slate-500">
      Leave blank when the product is not on sale.
    </p>

    <input
      id="sale_price"
      type="number"
      name="sale_price"
      min="0.01"
      step="0.01"
      class="w-full rounded-lg border p-3"
    />
  </div>
</div>

    <ProductVariantsField />

    <div class="rounded-xl border border-slate-200 bg-slate-50 p-5">
      <h2 class="font-semibold text-slate-900">Product SKU</h2>
      <p class="mt-2 text-sm leading-6 text-slate-500">
        A unique Layer Forge SKU will be generated automatically when this
        product is saved.
      </p>
    </div>

    <hr class="my-8" />

    <div class="rounded-xl border p-6">
      <h2 class="mb-2 text-xl font-bold">
        Available Materials
      </h2>

      <p class="mb-6 text-sm text-slate-500">
        Select the materials customers can order this product in.
      </p>

      <div class="grid gap-3 md:grid-cols-2">
        {
          materials?.map((material) => (
            <label class="flex items-center gap-3 rounded-lg border p-3">
              <input
                type="checkbox"
                name="materials"
                value={material.id}
              />

              <div>
                <div class="font-semibold">
                  {material.name}
                </div>
<div class="text-sm text-slate-500">
  {
    material.markup_percent === 0
      ? "Base material"
      : `+${material.markup_percent}% from PLA`
  }
</div>
              </div>
            </label>
          ))
        }
      </div>
    </div>

    <div class="flex flex-wrap items-center gap-6">
      <label class="flex items-center gap-2">
        <input
          type="checkbox"
          name="featured"
        />

        Featured
      </label>

      <label class="flex items-center gap-2">
        <input
          type="checkbox"
          name="active"
          checked
        />

        Active
      </label>
    </div>

    <button
      type="submit"
      class="rounded-lg bg-yellow-400 px-8 py-3 font-semibold hover:bg-yellow-300"
    >
      Save Product
    </button>
        </div>
      </section>

      <section class="rounded-2xl bg-white p-8 shadow">
        <div class="mb-5">
          <h2 class="text-2xl font-bold text-slate-900">Product Images</h2>
          <p class="mt-2 text-sm leading-6 text-slate-500">
            Upload one or more product images. Selected images will appear below
            before you save the product.
          </p>
        </div>

        <label
          for="images"
          class="mb-2 block font-semibold text-slate-900"
        >
          Upload Images
        </label>

        <input
          id="images"
          type="file"
          name="images"
          multiple
          accept="image/*"
          class="block w-full rounded-lg border border-slate-300 bg-white p-3 text-sm"
        />

        <p class="mt-2 text-sm text-slate-500">
          Select multiple images at once or add them in separate batches.
          Images are uploaded when you save the product.
        </p>

        <button
          id="addMoreImages"
          type="button"
          class="mt-4 w-full rounded-lg bg-yellow-400 px-5 py-3 font-semibold text-slate-950 transition hover:bg-yellow-300"
        >
          + Add More Images
        </button>

        <hr class="my-6 border-slate-300" />

        <div
          id="imagePreview"
          class="grid grid-cols-1 gap-4 sm:grid-cols-2"
          aria-live="polite"
        ></div>

        <p
          id="emptyImageState"
          class="rounded-xl border border-dashed border-slate-300 px-4 py-8 text-center text-sm text-slate-500"
        >
          No images selected yet.
        </p>
      </section>
    </div>
  </form>

  <script>
    const imageInput = document.getElementById("images");
    const imagePreview = document.getElementById("imagePreview");
    const addMoreImages = document.getElementById("addMoreImages");
    const emptyImageState = document.getElementById("emptyImageState");

    if (
      imageInput instanceof HTMLInputElement &&
      imagePreview instanceof HTMLElement &&
      addMoreImages instanceof HTMLButtonElement &&
      emptyImageState instanceof HTMLElement
    ) {
      let selectedImages = new DataTransfer();
      let previewUrls: string[] = [];

      const imageKey = (file: File) =>
        `${file.name}:${file.size}:${file.lastModified}`;

      const renderImages = () => {
        for (const previewUrl of previewUrls) {
          URL.revokeObjectURL(previewUrl);
        }

        previewUrls = [];
        imagePreview.replaceChildren();

        const files = Array.from(selectedImages.files);
        emptyImageState.hidden = files.length > 0;

        files.forEach((file, index) => {
          const card = document.createElement("div");
          card.className =
            "rounded-xl border border-slate-300 bg-white p-3 shadow-sm";

          const imageContainer = document.createElement("div");
          imageContainer.className =
            "flex aspect-square items-center justify-center overflow-hidden rounded-lg bg-slate-100";

          const previewUrl = URL.createObjectURL(file);
          previewUrls.push(previewUrl);

          const image = document.createElement("img");
          image.src = previewUrl;
          image.alt = file.name;
          image.className = "h-full w-full object-contain";

          const filename = document.createElement("p");
          filename.className =
            "mt-3 truncate text-center text-xs text-slate-600";
          filename.textContent = file.name;

          const removeButton = document.createElement("button");
          removeButton.type = "button";
          removeButton.className =
            "mt-3 w-full rounded-lg bg-red-600 px-4 py-2 text-sm font-semibold text-white transition hover:bg-red-500";
          removeButton.textContent = "Delete";

          removeButton.addEventListener("click", () => {
            const nextSelection = new DataTransfer();

            Array.from(selectedImages.files).forEach(
              (selectedFile, selectedIndex) => {
                if (selectedIndex !== index) {
                  nextSelection.items.add(selectedFile);
                }
              },
            );

            selectedImages = nextSelection;
            imageInput.files = selectedImages.files;
            renderImages();
          });

          imageContainer.appendChild(image);
          card.append(imageContainer, filename, removeButton);
          imagePreview.appendChild(card);
        });
      };

      imageInput.addEventListener("change", () => {
        const existingKeys = new Set(
          Array.from(selectedImages.files).map(imageKey),
        );

        for (const file of Array.from(imageInput.files ?? [])) {
          if (!existingKeys.has(imageKey(file))) {
            selectedImages.items.add(file);
            existingKeys.add(imageKey(file));
          }
        }

        imageInput.files = selectedImages.files;
        renderImages();
      });

      addMoreImages.addEventListener("click", () => {
        imageInput.click();
      });

      renderImages();
    }
  </script>/AdminLayout>
