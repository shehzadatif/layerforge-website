---
import AdminLayout from "../../layouts/AdminLayout.astro";
import { supabaseAdmin } from "../../lib/supabaseAdmin";

const created = Astro.url.searchParams.get("created") === "1";
const error = Astro.url.searchParams.get("error");

const { data: categories, error: categoriesError } = await supabaseAdmin
  .from("categories")
  .select("id, name, parent_id")
  .order("name");

if (categoriesError) {
  console.error("Unable to load categories.", categoriesError);
}

const categoryList = categories ?? [];
const parentCategories = categoryList.filter((category) => !category.parent_id);
const childrenByParent = new Map<string, typeof categoryList>();

for (const category of categoryList) {
  if (!category.parent_id) continue;

  const children = childrenByParent.get(category.parent_id) ?? [];
  children.push(category);
  childrenByParent.set(category.parent_id, children);
}
---

<AdminLayout title="Product Categories" active="categories">
  <div class="mb-8">
    <h1 class="text-4xl font-bold text-slate-900">Product Categories</h1>
    <p class="mt-2 text-slate-500">
      Organize products into main categories and customer-friendly
      subcategories.
    </p>
  </div>

  {
    created && (
      <div
        class="mb-6 rounded-xl border border-green-300 bg-green-50 px-5 py-4 text-green-800"
        role="status"
      >
        Category created successfully.
      </div>
    )
  }

  {
    error && (
      <div
        class="mb-6 rounded-xl border border-red-300 bg-red-50 px-5 py-4 text-red-800"
        role="alert"
      >
        {error === "duplicate"
          ? "A category with that name already exists at the selected level."
          : error === "missing-name"
            ? "Enter a category name."
            : "The category could not be saved. Please try again."}
      </div>
    )
  }

  <div class="grid gap-8 xl:grid-cols-[24rem_minmax(0,1fr)]">
    <section class="rounded-2xl bg-white p-6 shadow">
      <h2 class="text-2xl font-bold text-slate-900">Add Category</h2>
      <p class="mt-2 text-sm leading-6 text-slate-500">
        Leave the parent blank to create a main category. Select a parent to
        create a subcategory beneath it.
      </p>

      <form
        action="/api/admin/categories"
        method="POST"
        class="mt-6 space-y-5"
      >
        <div>
          <label for="name" class="mb-2 block font-semibold">Name</label>
          <input
            id="name"
            name="name"
            required
            maxlength="80"
            placeholder="e.g. Tool Management"
            class="w-full rounded-lg border p-3"
          />
        </div>

        <div>
          <label for="parent_id" class="mb-2 block font-semibold">
            Parent Category
          </label>
          <select
            id="parent_id"
            name="parent_id"
            class="w-full rounded-lg border p-3"
          >
            <option value="">None — create a main category</option>
            {
              parentCategories.map((category) => (
                <option value={category.id}>{category.name}</option>
              ))
            }
          </select>
        </div>

        <button
          type="submit"
          class="w-full rounded-lg bg-yellow-400 px-5 py-3 font-bold text-slate-950 transition hover:bg-yellow-300"
        >
          Create Category
        </button>
      </form>
    </section>

    <section class="rounded-2xl bg-white p-6 shadow">
      <h2 class="text-2xl font-bold text-slate-900">Category Structure</h2>

      <div class="mt-6 space-y-4">
        {
          parentCategories.map((parent) => {
            const children = childrenByParent.get(parent.id) ?? [];

            return (
              <article class="overflow-hidden rounded-xl border border-slate-200">
                <div class="flex items-center justify-between gap-4 bg-slate-50 px-5 py-4">
                  <h3 class="font-bold text-slate-900">{parent.name}</h3>
                  <span class="rounded-full bg-slate-200 px-3 py-1 text-xs font-semibold text-slate-600">
                    Main category
                  </span>
                </div>

                {children.length > 0 ? (
                  <ul class="divide-y divide-slate-100">
                    {children.map((child) => (
                      <li class="flex items-center gap-3 px-5 py-3 text-slate-700">
                        <span
                          class="h-1.5 w-1.5 rounded-full bg-yellow-400"
                          aria-hidden="true"
                        />
                        {child.name}
                      </li>
                    ))}
                  </ul>
                ) : (
                  <p class="px-5 py-4 text-sm text-slate-500">
                    No subcategories yet.
                  </p>
                )}
              </article>
            );
          })
        }
      </div>
    </section>
  </div>
</AdminLayout>
