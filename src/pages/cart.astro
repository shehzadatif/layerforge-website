---
import MainLayout from "../layouts/MainLayout.astro";
import CartPage from "../features/cart/components/CartPage";
import { getBulkDiscountConfig } from "../lib/bulkDiscountServer";

export const prerender = false;

const bulkDiscountConfig = await getBulkDiscountConfig();
---

<MainLayout title="Shopping Cart | Layer Forge Canada">

<section class="bg-slate-50 py-20">

  <div class="mx-auto max-w-7xl px-6">

    <h1 class="mb-10 text-5xl font-bold">
      Shopping Cart
    </h1>

    <CartPage client:load bulkDiscountConfig={bulkDiscountConfig} />

  </div>

</section>

</MainLayout>
