---
import MainLayout from "../layouts/MainLayout.astro";
import { getPacificDateInputValue } from "../lib/dateUtils";

const goals = [
  {
    id: "team-workplace",
    title: "Team & workplace",
    description: "Apparel and everyday items for staff or crews.",
  },
  {
    id: "client-gifts",
    title: "Client & employee gifts",
    description: "Thoughtful branded sets for thanks, welcomes or milestones.",
  },
  {
    id: "events-promotions",
    title: "Events & promotions",
    description: "Products that bring a launch, event or campaign together.",
  },
  {
    id: "products-packaging",
    title: "Products & packaging",
    description: "Labels and branded details for customer-facing products.",
  },
  {
    id: "personal-gifts",
    title: "Personalized gifts",
    description: "One-of-a-kind pieces made around a person or occasion.",
  },
  {
    id: "exploring",
    title: "I’m exploring",
    description: "Start with a few ideas and let us help shape the project.",
  },
];

const products = [
  {
    id: "apparel",
    title: "Apparel & workwear",
    description: "T-shirts, polos, hoodies, uniforms and team wear",
    image: "/images/apparel/custom-apparel-layerforge.webp",
    alt: "Custom branded apparel and tote bag",
    logoX: 50,
    logoY: 42,
    logoSize: 26,
  },
  {
    id: "drinkware",
    title: "Drinkware",
    description: "Tumblers, bottles and mugs",
    image: "/images/branding-studio/drinkware-blank-mockup.webp",
    alt: "Blank black insulated drink bottle for a branding concept",
    logoX: 50,
    logoY: 53,
    logoSize: 20,
  },
  {
    id: "gifts",
    title: "Gifts & keepsakes",
    description: "Welcome gifts, client gifts and personalized pieces",
    image: "/images/solutions/personalized-gifts.png",
    alt: "Collection of personalized gift ideas",
    logoX: 50,
    logoY: 50,
    logoSize: 25,
  },
  {
    id: "labels",
    title: "Labels & stickers",
    description: "Product labels, logo stickers and packaging details",
    image: "/images/solutions/promotional-products.png",
    alt: "Branded promotional products and labels",
    logoX: 50,
    logoY: 50,
    logoSize: 22,
  },
  {
    id: "phone-cases",
    title: "Phone cases & accessories",
    description: "Useful items with artwork, logos or names",
    image: "/images/uv-printing/uv-phone-cases.webp",
    alt: "Custom printed phone cases",
    logoX: 50,
    logoY: 49,
    logoSize: 16,
  },
  {
    id: "awards",
    title: "Awards & recognition",
    description: "Plaques, awards and milestone pieces",
    image: "/images/laser-engraving/engraved-products.webp",
    alt: "Collection of engraved products and awards",
    logoX: 50,
    logoY: 47,
    logoSize: 20,
  },
  {
    id: "custom-item",
    title: "Something different",
    description: "A customer-supplied item or another custom idea",
    image: "/images/solutions/custom-projects.png",
    alt: "Examples of custom project possibilities",
    logoX: 50,
    logoY: 50,
    logoSize: 23,
  },
];
---

<MainLayout
  title="Branding Studio | Build Your Custom Product Project"
  description="Build a custom branding project with Layer Forge Canada. Choose products, upload your logo, create a concept preview, and send one complete project plan."
  image="/images/uv-printing/uv-printing-hero.webp"
>
  <section class="relative isolate overflow-hidden bg-slate-950 text-white">
    <img
      src="/images/uv-printing/uv-printing-hero.webp"
      alt="Collection of custom branded products"
      class="absolute inset-0 h-full w-full object-cover object-center opacity-35"
      fetchpriority="high"
    />
    <div class="absolute inset-0 bg-gradient-to-r from-black via-slate-950/95 to-slate-950/60"></div>
    <div class="relative mx-auto max-w-7xl px-6 py-20 sm:py-24">
      <div class="max-w-4xl">
        <div class="inline-flex items-center gap-3 rounded-full border border-white/15 bg-white/10 px-4 py-2 text-sm font-bold text-yellow-300 backdrop-blur">
          <span class="grid h-7 w-7 place-items-center rounded-lg bg-slate-950">
            <img src="/favicon.svg?v=brand-mark-2" alt="" class="h-6 w-6" />
          </span>
          Interactive project planner
        </div>
        <h1 class="mt-7 text-5xl font-black leading-[1.02] tracking-tight sm:text-6xl lg:text-7xl">
          Build your branding project.
        </h1>
        <p class="mt-6 max-w-3xl text-lg leading-8 text-slate-200 sm:text-xl">
          Choose what you’re planning, combine products, upload your logo, and
          see a quick concept before sending us one complete project brief.
        </p>
        <div class="mt-9 flex flex-wrap gap-4 text-sm font-bold text-slate-200">
          <span class="rounded-full border border-white/15 bg-white/5 px-4 py-2">No technical details needed</span>
          <span class="rounded-full border border-white/15 bg-white/5 px-4 py-2">Mix product categories</span>
          <span class="rounded-full border border-white/15 bg-white/5 px-4 py-2">Concept preview included</span>
        </div>
      </div>
    </div>
  </section>

  <section class="bg-slate-100 py-12 sm:py-16">
    <div class="mx-auto max-w-7xl px-4 sm:px-6">
      <form
        id="branding-studio-form"
        enctype="multipart/form-data"
        class="grid gap-8 lg:grid-cols-[minmax(0,1fr)_24rem] lg:items-start"
      >
        <input type="hidden" name="service" value="UV Printing" />
        <input type="hidden" name="itemType" value="Branding Studio project" />
        <input type="hidden" name="projectPurpose" value="" />
        <input
          type="text"
          name="website"
          tabindex="-1"
          autocomplete="off"
          class="hidden"
          aria-hidden="true"
        />

        <div class="space-y-8">
          <fieldset
            data-studio-step="goal"
            class="rounded-3xl border border-slate-200 bg-white p-6 shadow-sm sm:p-9"
          >
            <legend class="sr-only">Choose your project goal</legend>
            <div class="flex items-start gap-4">
              <span class="grid h-11 w-11 shrink-0 place-items-center rounded-2xl bg-yellow-400 text-lg font-black text-slate-950">1</span>
              <div>
                <h2 class="text-2xl font-black text-slate-950 sm:text-3xl">What are you planning?</h2>
                <p class="mt-2 leading-7 text-slate-600">Choose the outcome that is closest to your project.</p>
              </div>
            </div>
            <div class="mt-7 grid gap-3 sm:grid-cols-2">
              {
                goals.map((goal) => (
                  <label class="group cursor-pointer">
                    <input
                      class="peer sr-only"
                      type="radio"
                      name="studioGoal"
                      value={goal.id}
                      data-goal-title={goal.title}
                    />
                    <span class="block h-full rounded-2xl border-2 border-slate-200 p-5 transition group-hover:border-yellow-300 group-hover:bg-yellow-50 peer-checked:border-yellow-400 peer-checked:bg-yellow-50 peer-focus-visible:ring-4 peer-focus-visible:ring-sky-200">
                      <strong class="block text-base font-black text-slate-950">{goal.title}</strong>
                      <small class="mt-2 block text-sm leading-6 text-slate-600">{goal.description}</small>
                    </span>
                  </label>
                ))
              }
            </div>
            <p data-goal-error class="mt-4 hidden text-sm font-bold text-red-700" role="alert">Choose a project goal to continue.</p>
          </fieldset>

          <fieldset
            data-studio-step="products"
            class="rounded-3xl border border-slate-200 bg-white p-6 shadow-sm sm:p-9"
          >
            <legend class="sr-only">Choose products</legend>
            <div class="flex items-start gap-4">
              <span class="grid h-11 w-11 shrink-0 place-items-center rounded-2xl bg-yellow-400 text-lg font-black text-slate-950">2</span>
              <div>
                <h2 class="text-2xl font-black text-slate-950 sm:text-3xl">Choose your product mix.</h2>
                <p class="mt-2 leading-7 text-slate-600">Select one category or combine several into a coordinated package.</p>
              </div>
            </div>
            <div class="mt-7 grid gap-4 sm:grid-cols-2 xl:grid-cols-3">
              {
                products.map((product) => (
                  <label
                    class="group cursor-pointer"
                    data-product-card
                    data-product-id={product.id}
                    data-product-title={product.title}
                    data-product-image={product.image}
                    data-logo-x={product.logoX}
                    data-logo-y={product.logoY}
                    data-logo-size={product.logoSize}
                  >
                    <input
                      class="peer sr-only"
                      type="checkbox"
                      name="studioProducts"
                      value={product.id}
                    />
                    <span class="relative block h-full overflow-hidden rounded-2xl border-2 border-slate-200 bg-white transition group-hover:-translate-y-0.5 group-hover:border-yellow-300 peer-checked:border-yellow-400 peer-checked:ring-4 peer-checked:ring-yellow-100 peer-focus-visible:ring-4 peer-focus-visible:ring-sky-200">
                      <span data-selected-mark class="absolute right-3 top-3 z-10 grid h-8 w-8 place-items-center rounded-full border-2 border-white bg-slate-950 text-sm font-black text-white opacity-0 shadow">✓</span>
                      <img src={product.image} alt={product.alt} loading="lazy" class="aspect-[4/3] w-full object-cover" />
                      <span class="block p-4">
                        <strong class="block font-black text-slate-950">{product.title}</strong>
                        <small class="mt-1.5 block text-sm leading-5 text-slate-600">{product.description}</small>
                      </span>
                    </span>
                  </label>
                ))
              }
            </div>
            <p data-products-error class="mt-4 hidden text-sm font-bold text-red-700" role="alert">Choose at least one product category to continue.</p>
          </fieldset>

          <fieldset class="rounded-3xl border border-slate-200 bg-white p-6 shadow-sm sm:p-9">
            <legend class="sr-only">Add artwork and adjust the concept preview</legend>
            <div class="flex items-start gap-4">
              <span class="grid h-11 w-11 shrink-0 place-items-center rounded-2xl bg-yellow-400 text-lg font-black text-slate-950">3</span>
              <div>
                <h2 class="text-2xl font-black text-slate-950 sm:text-3xl">Add your logo or artwork.</h2>
                <p class="mt-2 leading-7 text-slate-600">Previewable image files appear on the concept board. Other artwork can still be attached for review.</p>
              </div>
            </div>

            <div class="mt-7 grid gap-6 sm:grid-cols-2">
              <div>
                <span class="text-sm font-bold text-slate-700">Artwork file <span class="font-normal text-slate-500">(optional)</span></span>
                <label for="studio-artwork" class="mt-2 flex min-h-40 cursor-pointer flex-col items-center justify-center rounded-2xl border-2 border-dashed border-slate-300 bg-slate-50 px-5 py-7 text-center transition hover:border-yellow-400 hover:bg-yellow-50">
                  <svg class="h-8 w-8 text-slate-700" viewBox="0 0 24 24" fill="none" aria-hidden="true"><path d="M12 16V4m0 0L7 9m5-5 5 5M5 14v4a2 2 0 0 0 2 2h10a2 2 0 0 0 2-2v-4" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" /></svg>
                  <strong class="mt-3 text-slate-900">Choose your logo or artwork</strong>
                  <span class="mt-1 text-xs leading-5 text-slate-500">PNG, JPG, WEBP or SVG for preview<br />AI, EPS or PDF for review · up to 50 MB</span>
                </label>
                <input id="studio-artwork" name="file" type="file" accept=".ai,.svg,.eps,.pdf,.png,.jpg,.jpeg,.webp" class="hidden" />
                <div class="mt-3 flex items-center justify-between gap-3">
                  <p data-file-name class="min-w-0 truncate text-sm font-semibold text-slate-700" aria-live="polite">No file selected</p>
                  <button type="button" data-clear-artwork class="hidden shrink-0 text-sm font-bold text-slate-600 underline decoration-yellow-400 decoration-2 underline-offset-4">Remove</button>
                </div>
              </div>

              <div class="space-y-5">
                <label class="block">
                  <span class="text-sm font-bold text-slate-700">Preview on</span>
                  <select data-preview-select class="mt-2 w-full rounded-xl border border-slate-300 bg-white px-4 py-3 focus:border-yellow-400 focus:outline-none focus:ring-2 focus:ring-yellow-200">
                    {products.map((product) => <option value={product.id}>{product.title}</option>)}
                  </select>
                </label>
                <label class="block">
                  <span class="flex items-center justify-between text-sm font-bold text-slate-700"><span>Logo size</span><output data-logo-size-output>26%</output></span>
                  <input data-logo-size type="range" min="10" max="55" value="26" class="mt-3 w-full accent-yellow-400" />
                </label>
                <div>
                  <span class="text-sm font-bold text-slate-700">Quick position</span>
                  <div class="mt-2 grid w-32 grid-cols-3 gap-1.5" aria-label="Logo position">
                    {[[25, 25], [50, 25], [75, 25], [25, 50], [50, 50], [75, 50], [25, 75], [50, 75], [75, 75]].map(([x, y]) => (
                      <button type="button" data-logo-position data-x={x} data-y={y} aria-label={`Place logo at ${x === 25 ? "left" : x === 75 ? "right" : "centre"} ${y === 25 ? "top" : y === 75 ? "bottom" : "middle"}`} class="h-9 rounded-lg border border-slate-300 bg-slate-50 transition hover:border-yellow-400 hover:bg-yellow-50"><span class="mx-auto block h-2 w-2 rounded-full bg-slate-500"></span></button>
                    ))}
                  </div>
                  <p class="mt-2 text-xs leading-5 text-slate-500">You can also drag the artwork directly on the preview.</p>
                </div>
              </div>
            </div>
          </fieldset>

          <fieldset class="rounded-3xl border border-slate-200 bg-white p-6 shadow-sm sm:p-9">
            <legend class="sr-only">Project details and contact information</legend>
            <div class="flex items-start gap-4">
              <span class="grid h-11 w-11 shrink-0 place-items-center rounded-2xl bg-yellow-400 text-lg font-black text-slate-950">4</span>
              <div>
                <h2 class="text-2xl font-black text-slate-950 sm:text-3xl">Complete your project brief.</h2>
                <p class="mt-2 leading-7 text-slate-600">Add the practical details so we can recommend suitable options, pricing and timing.</p>
              </div>
            </div>

            <div class="mt-7 grid gap-5 sm:grid-cols-2">
              <label class="block"><span class="text-sm font-bold text-slate-700">Approximate quantity *</span><input name="quantity" data-studio-quantity type="number" min="1" max="10000" value="1" required class="mt-2 w-full rounded-xl border border-slate-300 px-4 py-3.5 focus:border-yellow-400 focus:outline-none focus:ring-2 focus:ring-yellow-200" /></label>
              <label class="block"><span class="text-sm font-bold text-slate-700">Preferred completion date</span><input name="dueDate" data-studio-due-date type="date" min={getPacificDateInputValue(3)} class="mt-2 w-full rounded-xl border border-slate-300 px-4 py-3.5 focus:border-yellow-400 focus:outline-none focus:ring-2 focus:ring-yellow-200" /></label>
              <label class="block"><span class="text-sm font-bold text-slate-700">Budget range</span><select name="studioBudget" data-studio-budget class="mt-2 w-full rounded-xl border border-slate-300 bg-white px-4 py-3.5 focus:border-yellow-400 focus:outline-none focus:ring-2 focus:ring-yellow-200"><option value="">Help me understand the options</option><option>Under $250</option><option>$250–$500</option><option>$500–$1,000</option><option>$1,000–$2,500</option><option>$2,500+</option></select></label>
              <label class="block"><span class="text-sm font-bold text-slate-700">Product sourcing</span><select name="productSource" data-studio-source class="mt-2 w-full rounded-xl border border-slate-300 bg-white px-4 py-3.5 focus:border-yellow-400 focus:outline-none focus:ring-2 focus:ring-yellow-200"><option value="">Help me decide</option><option>Layer Forge should source the products</option><option>I already have the products</option><option>A mix of sourced and supplied products</option></select></label>
              <label class="block sm:col-span-2"><span class="text-sm font-bold text-slate-700">Anything else we should know?</span><textarea name="studioNotes" data-studio-notes rows="5" maxlength="1800" placeholder="Tell us about colours, sizes, individual names, packaging, the audience, or any other priorities." class="mt-2 w-full rounded-xl border border-slate-300 px-4 py-3.5 focus:border-yellow-400 focus:outline-none focus:ring-2 focus:ring-yellow-200"></textarea></label>
            </div>

            <div class="my-9 border-t border-slate-200"></div>
            <h3 class="text-xl font-black text-slate-950">Where should we send the project response?</h3>
            <div class="mt-5 grid gap-5 sm:grid-cols-2">
              <label class="block"><span class="text-sm font-bold text-slate-700">Full name *</span><input name="name" type="text" required autocomplete="name" class="mt-2 w-full rounded-xl border border-slate-300 px-4 py-3.5 focus:border-yellow-400 focus:outline-none focus:ring-2 focus:ring-yellow-200" /></label>
              <label class="block"><span class="text-sm font-bold text-slate-700">Email *</span><input name="email" type="email" required autocomplete="email" class="mt-2 w-full rounded-xl border border-slate-300 px-4 py-3.5 focus:border-yellow-400 focus:outline-none focus:ring-2 focus:ring-yellow-200" /></label>
              <label class="block"><span class="text-sm font-bold text-slate-700">Phone</span><input name="phone" type="tel" autocomplete="tel" class="mt-2 w-full rounded-xl border border-slate-300 px-4 py-3.5 focus:border-yellow-400 focus:outline-none focus:ring-2 focus:ring-yellow-200" /></label>
              <label class="block"><span class="text-sm font-bold text-slate-700">Business or organization</span><input name="company" type="text" autocomplete="organization" class="mt-2 w-full rounded-xl border border-slate-300 px-4 py-3.5 focus:border-yellow-400 focus:outline-none focus:ring-2 focus:ring-yellow-200" /></label>
              <label class="block sm:col-span-2"><span class="text-sm font-bold text-slate-700">Delivery preference</span><select name="deliveryMethod" data-studio-delivery class="mt-2 w-full rounded-xl border border-slate-300 bg-white px-4 py-3.5 focus:border-yellow-400 focus:outline-none focus:ring-2 focus:ring-yellow-200"><option value="">Not sure yet</option><option>Pickup</option><option>Local Delivery</option><option>Shipping</option></select></label>
            </div>
          </fieldset>

          <div class="rounded-3xl bg-slate-950 p-6 text-white shadow-xl sm:p-8">
            <p class="text-sm leading-6 text-slate-300">Your concept helps communicate the direction; it is not a production proof. We’ll confirm product compatibility, artwork, placement, colours, pricing and timing with you before production.</p>
            <button type="submit" class="mt-5 w-full rounded-xl bg-yellow-400 px-8 py-4 text-lg font-black text-slate-950 transition hover:bg-yellow-300 disabled:cursor-wait disabled:opacity-65">Send My Branding Plan</button>
            <p data-form-error class="mt-4 hidden rounded-xl border border-red-300/40 bg-red-500/10 p-4 text-sm font-semibold text-red-100" role="alert"></p>
          </div>
        </div>

        <aside class="lg:sticky lg:top-6">
          <div class="overflow-hidden rounded-3xl border border-slate-200 bg-white shadow-xl">
            <div class="border-b border-slate-200 bg-slate-950 px-5 py-4 text-white">
              <p class="text-xs font-black uppercase tracking-[0.2em] text-yellow-400">Your concept</p>
              <h2 class="mt-1 text-xl font-black">Branding Studio preview</h2>
            </div>
            <div data-preview-frame class="studio-preview relative aspect-square touch-none overflow-hidden bg-slate-200">
              <img data-preview-product src={products[0].image} alt={products[0].alt} class="h-full w-full object-cover" />
              <div data-preview-shade class="absolute inset-0 bg-black/5"></div>
              <div data-preview-placeholder class="absolute inset-0 z-10 grid place-items-center p-8 text-center">
                <div data-preview-placeholder-copy class="rounded-2xl border border-white/60 bg-black/65 px-5 py-4 text-sm font-bold text-white shadow-lg backdrop-blur">Upload artwork to place it on this concept</div>
              </div>
              <img data-preview-logo alt="Uploaded artwork concept preview" class="studio-preview__logo absolute z-20 max-h-none max-w-none cursor-move select-none object-contain drop-shadow-[0_3px_5px_rgba(0,0,0,0.45)]" draggable="false" hidden />
              <span class="absolute bottom-3 left-3 rounded-full bg-black/70 px-3 py-1.5 text-[10px] font-black uppercase tracking-[0.13em] text-white backdrop-blur">Concept only</span>
            </div>
            <div class="p-5">
              <p class="text-xs font-black uppercase tracking-[0.18em] text-slate-500">Project summary</p>
              <dl class="mt-4 space-y-3 text-sm">
                <div class="flex gap-3"><dt class="w-20 shrink-0 font-bold text-slate-500">Goal</dt><dd data-summary-goal class="font-semibold text-slate-900">Not selected</dd></div>
                <div class="flex gap-3"><dt class="w-20 shrink-0 font-bold text-slate-500">Quantity</dt><dd data-summary-quantity class="font-semibold text-slate-900">1</dd></div>
                <div class="flex gap-3"><dt class="w-20 shrink-0 font-bold text-slate-500">Needed by</dt><dd data-summary-date class="font-semibold text-slate-900">Flexible</dd></div>
              </dl>
              <div class="mt-5 border-t border-slate-200 pt-4">
                <p class="text-xs font-black uppercase tracking-[0.18em] text-slate-500">Products</p>
                <div data-summary-products class="mt-3 flex flex-wrap gap-2"><span class="text-sm text-slate-500">None selected yet</span></div>
              </div>
              <div class="mt-5 rounded-2xl bg-yellow-50 p-4 text-xs leading-5 text-slate-700 ring-1 ring-yellow-200">Your choices are saved in this browser while you build the project. Artwork is not uploaded until you press “Send My Branding Plan.”</div>
            </div>
          </div>
        </aside>
      </form>
    </div>
  </section>

  <script>
    interface ProductPreview {
      id: string;
      title: string;
      image: string;
      logoX: number;
      logoY: number;
      logoSize: number;
    }

    interface StudioState {
      goal?: string;
      products?: string[];
      previewProduct?: string;
      logoX?: number;
      logoY?: number;
      logoSize?: number;
      quantity?: string;
      dueDate?: string;
      budget?: string;
      source?: string;
      notes?: string;
      delivery?: string;
    }

    const form = document.querySelector<HTMLFormElement>("#branding-studio-form");

    if (form) {
      const STORAGE_KEY = "layerforge-branding-studio-v1";
      const productCards = Array.from(form.querySelectorAll<HTMLElement>("[data-product-card]"));
      const productMap = new Map<string, ProductPreview>();
      productCards.forEach((card) => {
        const id = card.dataset.productId ?? "";
        if (!id) return;
        productMap.set(id, {
          id,
          title: card.dataset.productTitle ?? id,
          image: card.dataset.productImage ?? "",
          logoX: Number(card.dataset.logoX ?? 50),
          logoY: Number(card.dataset.logoY ?? 50),
          logoSize: Number(card.dataset.logoSize ?? 24),
        });
      });

      const goalInputs = Array.from(form.querySelectorAll<HTMLInputElement>('input[name="studioGoal"]'));
      const productInputs = Array.from(form.querySelectorAll<HTMLInputElement>('input[name="studioProducts"]'));
      const projectPurpose = form.querySelector<HTMLInputElement>('input[name="projectPurpose"]');
      const itemType = form.querySelector<HTMLInputElement>('input[name="itemType"]');
      const artwork = form.querySelector<HTMLInputElement>("#studio-artwork");
      const fileName = form.querySelector<HTMLElement>("[data-file-name]");
      const clearArtwork = form.querySelector<HTMLButtonElement>("[data-clear-artwork]");
      const previewSelect = form.querySelector<HTMLSelectElement>("[data-preview-select]");
      const previewFrame = form.querySelector<HTMLElement>("[data-preview-frame]");
      const previewProduct = form.querySelector<HTMLImageElement>("[data-preview-product]");
      const previewLogo = form.querySelector<HTMLImageElement>("[data-preview-logo]");
      const previewPlaceholder = form.querySelector<HTMLElement>("[data-preview-placeholder]");
      const previewPlaceholderCopy = form.querySelector<HTMLElement>("[data-preview-placeholder-copy]");
      const logoSizeInput = form.querySelector<HTMLInputElement>("[data-logo-size]");
      const logoSizeOutput = form.querySelector<HTMLOutputElement>("[data-logo-size-output]");
      const quantity = form.querySelector<HTMLInputElement>("[data-studio-quantity]");
      const dueDate = form.querySelector<HTMLInputElement>("[data-studio-due-date]");
      const budget = form.querySelector<HTMLSelectElement>("[data-studio-budget]");
      const productSource = form.querySelector<HTMLSelectElement>("[data-studio-source]");
      const studioNotes = form.querySelector<HTMLTextAreaElement>("[data-studio-notes]");
      const delivery = form.querySelector<HTMLSelectElement>("[data-studio-delivery]");
      const summaryGoal = form.querySelector<HTMLElement>("[data-summary-goal]");
      const summaryQuantity = form.querySelector<HTMLElement>("[data-summary-quantity]");
      const summaryDate = form.querySelector<HTMLElement>("[data-summary-date]");
      const summaryProducts = form.querySelector<HTMLElement>("[data-summary-products]");
      const goalError = form.querySelector<HTMLElement>("[data-goal-error]");
      const productsError = form.querySelector<HTMLElement>("[data-products-error]");
      const formError = form.querySelector<HTMLElement>("[data-form-error]");
      let artworkUrl = "";
      let logoX = 50;
      let logoY = 42;
      let dragging = false;

      const selectedGoal = () => goalInputs.find((input) => input.checked);
      const selectedProducts = () => productInputs.filter((input) => input.checked);

      const applyLogoPosition = () => {
        if (!previewLogo) return;
        previewLogo.style.left = `${logoX}%`;
        previewLogo.style.top = `${logoY}%`;
        previewLogo.style.width = `${Number(logoSizeInput?.value ?? 24)}%`;
        previewLogo.style.transform = "translate(-50%, -50%)";
        if (logoSizeOutput) logoSizeOutput.textContent = `${logoSizeInput?.value ?? 24}%`;
      };

      const setPreviewProduct = (id: string, resetPlacement = true) => {
        const product = productMap.get(id);
        if (!product || !previewProduct || !previewSelect) return;
        previewSelect.value = id;
        previewProduct.src = product.image;
        previewProduct.alt = `${product.title} concept preview`;
        if (resetPlacement) {
          logoX = product.logoX;
          logoY = product.logoY;
          if (logoSizeInput) logoSizeInput.value = String(product.logoSize);
        }
        applyLogoPosition();
      };

      const updateSummary = () => {
        const goal = selectedGoal();
        const products = selectedProducts();
        if (summaryGoal) summaryGoal.textContent = goal?.dataset.goalTitle ?? "Not selected";
        if (summaryQuantity) summaryQuantity.textContent = quantity?.value || "1";
        if (summaryDate) {
          summaryDate.textContent = dueDate?.value
            ? new Intl.DateTimeFormat("en-CA", { dateStyle: "medium" }).format(new Date(`${dueDate.value}T12:00:00`))
            : "Flexible";
        }
        if (summaryProducts) {
          summaryProducts.replaceChildren();
          if (!products.length) {
            const empty = document.createElement("span");
            empty.className = "text-sm text-slate-500";
            empty.textContent = "None selected yet";
            summaryProducts.append(empty);
          } else {
            products.forEach((input) => {
              const product = productMap.get(input.value);
              const chip = document.createElement("span");
              chip.className = "rounded-full bg-slate-100 px-3 py-1.5 text-xs font-bold text-slate-800";
              chip.textContent = product?.title ?? input.value;
              summaryProducts.append(chip);
            });
          }
        }
        if (projectPurpose) projectPurpose.value = goal?.dataset.goalTitle ?? "";
        if (itemType) {
          const names = products.map((input) => productMap.get(input.value)?.title ?? input.value);
          itemType.value = `Branding Studio: ${names.join(", ")}`.slice(0, 160);
        }
      };

      const stateValue = (): StudioState => ({
        goal: selectedGoal()?.value,
        products: selectedProducts().map((input) => input.value),
        previewProduct: previewSelect?.value,
        logoX,
        logoY,
        logoSize: Number(logoSizeInput?.value ?? 24),
        quantity: quantity?.value,
        dueDate: dueDate?.value,
        budget: budget?.value,
        source: productSource?.value,
        notes: studioNotes?.value,
        delivery: delivery?.value,
      });

      const saveState = () => {
        try {
          sessionStorage.setItem(STORAGE_KEY, JSON.stringify(stateValue()));
        } catch {
          // The Studio remains usable if browser storage is unavailable.
        }
      };

      const restoreState = () => {
        let state: StudioState = {};
        try {
          state = JSON.parse(sessionStorage.getItem(STORAGE_KEY) ?? "{}") as StudioState;
        } catch {
          state = {};
        }
        const params = new URLSearchParams(window.location.search);
        const requestedGoal = params.get("goal") || state.goal;
        const requestedProducts = params.get("products")?.split(",").filter(Boolean) ?? state.products ?? [];
        goalInputs.forEach((input) => { input.checked = input.value === requestedGoal; });
        productInputs.forEach((input) => { input.checked = requestedProducts.includes(input.value); });
        if (quantity && state.quantity) quantity.value = state.quantity;
        if (dueDate && state.dueDate) dueDate.value = state.dueDate;
        if (budget && state.budget) budget.value = state.budget;
        if (productSource && state.source) productSource.value = state.source;
        if (studioNotes && state.notes) studioNotes.value = state.notes;
        if (delivery && state.delivery) delivery.value = state.delivery;
        const previewId = state.previewProduct && productMap.has(state.previewProduct)
          ? state.previewProduct
          : requestedProducts[0] ?? previewSelect?.value ?? "apparel";
        setPreviewProduct(previewId);
        if (typeof state.logoX === "number") logoX = state.logoX;
        if (typeof state.logoY === "number") logoY = state.logoY;
        if (logoSizeInput && typeof state.logoSize === "number") logoSizeInput.value = String(state.logoSize);
        applyLogoPosition();
        updateSummary();
      };

      goalInputs.forEach((input) => input.addEventListener("change", () => {
        goalError?.classList.add("hidden");
        updateSummary();
        saveState();
      }));
      productInputs.forEach((input) => input.addEventListener("change", () => {
        productsError?.classList.add("hidden");
        if (input.checked) setPreviewProduct(input.value);
        updateSummary();
        saveState();
      }));
      [quantity, dueDate, budget, productSource, studioNotes, delivery].forEach((field) => field?.addEventListener("input", () => {
        updateSummary();
        saveState();
      }));

      previewSelect?.addEventListener("change", () => {
        setPreviewProduct(previewSelect.value);
        saveState();
      });
      logoSizeInput?.addEventListener("input", () => {
        applyLogoPosition();
        saveState();
      });
      form.querySelectorAll<HTMLButtonElement>("[data-logo-position]").forEach((button) => {
        button.addEventListener("click", () => {
          logoX = Number(button.dataset.x ?? 50);
          logoY = Number(button.dataset.y ?? 50);
          applyLogoPosition();
          saveState();
        });
      });

      const clearArtworkPreview = () => {
        if (artworkUrl) URL.revokeObjectURL(artworkUrl);
        artworkUrl = "";
        if (artwork) artwork.value = "";
        if (previewLogo) {
          previewLogo.onload = null;
          previewLogo.onerror = null;
          previewLogo.removeAttribute("src");
          previewLogo.hidden = true;
        }
        if (previewPlaceholder) previewPlaceholder.hidden = false;
        if (previewPlaceholderCopy) previewPlaceholderCopy.textContent = "Upload artwork to place it on this concept";
        clearArtwork?.classList.add("hidden");
        if (fileName) fileName.textContent = "No file selected";
      };

      artwork?.addEventListener("change", () => {
        if (artworkUrl) URL.revokeObjectURL(artworkUrl);
        artworkUrl = "";
        const file = artwork.files?.[0];
        if (!file) {
          clearArtworkPreview();
          return;
        }
        if (fileName) fileName.textContent = file.name;
        clearArtwork?.classList.remove("hidden");
        const previewable = file.type.startsWith("image/") || /\.(?:png|jpe?g|webp|gif|svg)$/i.test(file.name);
        if (previewable && previewLogo) {
          artworkUrl = URL.createObjectURL(file);
          previewLogo.hidden = true;
          if (previewPlaceholderCopy) previewPlaceholderCopy.textContent = "Preparing your artwork preview…";
          if (previewPlaceholder) previewPlaceholder.hidden = false;
          previewLogo.onload = () => {
            previewLogo.hidden = false;
            if (previewPlaceholder) previewPlaceholder.hidden = true;
            applyLogoPosition();
          };
          previewLogo.onerror = () => {
            previewLogo.hidden = true;
            if (previewPlaceholderCopy) previewPlaceholderCopy.textContent = "This image is attached, but the browser could not display a preview.";
            if (previewPlaceholder) previewPlaceholder.hidden = false;
          };
          previewLogo.src = artworkUrl;
        } else {
          if (previewLogo) previewLogo.hidden = true;
          if (previewPlaceholderCopy) previewPlaceholderCopy.textContent = `${file.name} is attached for review but cannot be previewed here.`;
          if (previewPlaceholder) previewPlaceholder.hidden = false;
        }
      });
      clearArtwork?.addEventListener("click", clearArtworkPreview);

      const moveLogo = (clientX: number, clientY: number) => {
        if (!previewFrame || !previewLogo || previewLogo.hidden) return;
        const bounds = previewFrame.getBoundingClientRect();
        logoX = Math.min(90, Math.max(10, ((clientX - bounds.left) / bounds.width) * 100));
        logoY = Math.min(90, Math.max(10, ((clientY - bounds.top) / bounds.height) * 100));
        applyLogoPosition();
      };
      previewLogo?.addEventListener("pointerdown", (event) => {
        dragging = true;
        previewLogo.setPointerCapture(event.pointerId);
        moveLogo(event.clientX, event.clientY);
      });
      previewLogo?.addEventListener("pointermove", (event) => {
        if (dragging) moveLogo(event.clientX, event.clientY);
      });
      previewLogo?.addEventListener("pointerup", () => {
        dragging = false;
        saveState();
      });
      previewLogo?.addEventListener("pointercancel", () => { dragging = false; });

      form.addEventListener("submit", async (event) => {
        event.preventDefault();
        formError?.classList.add("hidden");
        const goal = selectedGoal();
        const chosenProducts = selectedProducts();
        let firstInvalidStep: HTMLElement | null = null;
        if (!goal) {
          goalError?.classList.remove("hidden");
          firstInvalidStep = form.querySelector<HTMLElement>('[data-studio-step="goal"]');
        }
        if (!chosenProducts.length) {
          productsError?.classList.remove("hidden");
          firstInvalidStep ??= form.querySelector<HTMLElement>('[data-studio-step="products"]');
        }
        if (firstInvalidStep) {
          firstInvalidStep.scrollIntoView({ behavior: "smooth", block: "start" });
          return;
        }
        if (!form.reportValidity()) return;

        const submitButton = form.querySelector<HTMLButtonElement>('button[type="submit"]');
        if (!submitButton) return;
        submitButton.disabled = true;
        submitButton.textContent = "Sending your plan…";

        const productNames = chosenProducts.map((input) => productMap.get(input.value)?.title ?? input.value);
        const details = [
          "Branding Studio project",
          `Goal: ${goal?.dataset.goalTitle ?? "Not specified"}`,
          `Selected products: ${productNames.join(", ")}`,
          `Budget range: ${budget?.value || "Not specified"}`,
          artwork?.files?.[0]
            ? `Concept placement: ${previewSelect?.selectedOptions[0]?.textContent ?? "Selected product"}, approximately ${Math.round(logoX)}% from left / ${Math.round(logoY)}% from top, logo size ${logoSizeInput?.value ?? "24"}%.`
            : "Artwork: No file attached.",
          studioNotes?.value.trim() ? `Additional details: ${studioNotes.value.trim()}` : "Additional details: None provided.",
        ];
        const formData = new FormData(form);
        formData.delete("studioGoal");
        formData.delete("studioProducts");
        formData.delete("studioBudget");
        formData.delete("studioNotes");
        formData.set("notes", details.join("\n"));

        try {
          const response = await fetch("/api/quote", { method: "POST", body: formData });
          const result = await response.json();
          if (response.ok && result.success) {
            try { sessionStorage.removeItem(STORAGE_KEY); } catch {}
            window.location.href = result.redirect;
            return;
          }
          throw new Error(result.error || "Unable to send your branding plan.");
        } catch (error) {
          if (formError) {
            formError.textContent = error instanceof Error ? error.message : "Unable to send your branding plan.";
            formError.classList.remove("hidden");
          }
          submitButton.disabled = false;
          submitButton.textContent = "Send My Branding Plan";
        }
      });

      restoreState();
      window.addEventListener("beforeunload", () => {
        if (artworkUrl) URL.revokeObjectURL(artworkUrl);
      });
    }
  </script>

  <style>
    label[data-product-card]:has(input:checked) [data-selected-mark] {
      opacity: 1;
    }

    .studio-preview__logo {
      outline: 2px dashed rgb(250 204 21 / 0.95);
      outline-offset: 5px;
      user-select: none;
      -webkit-user-drag: none;
    }

    @media (prefers-reduced-motion: reduce) {
      :global(.studio-preview *) {
        scroll-behavior: auto;
      }
    }
  </style>
</MainLayout>
