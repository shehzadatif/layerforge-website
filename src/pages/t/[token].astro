---
import MainLayout from "../../layouts/MainLayout.astro";
import { isPickupDeliveryMethod } from "../../lib/deliveryMethod";
import { supabaseAdmin } from "../../lib/supabaseAdmin";
import { formatPacificDateTime } from "../../lib/dateUtils";
import {
  formatEstimatedReadyDate,
  formatProductionDuration,
  getOrderProductionDays,
} from "../../lib/productionEstimate";

const { token } = Astro.params;

const { data: order, error } = await supabaseAdmin
  .from("orders")
  .select(`
    *,
    order_items(*),
    order_shipping_packages(*)
  `)
  .eq("tracking_token", token)
  .maybeSingle();

const orderNumber = order
  ? "LF" + String(order.order_number).padStart(6, "0")
  : "";

const isLocalPickup = isPickupDeliveryMethod(order?.delivery_method);

const productionDays = getOrderProductionDays(order?.order_items);
const estimatedReadyDate = order
  ? formatEstimatedReadyDate(order.created_at, productionDays)
  : null;
const carrierTrackingUrl = (() => {
  const value = String(order?.shipping_tracking_url ?? "").trim();
  if (!value) return "";

  try {
    const parsed = new URL(value);
    return parsed.protocol === "https:" ? parsed.toString() : "";
  } catch {
    return "";
  }
})();
const parcelTracking = order
  ? (Array.isArray(order.order_shipping_packages) &&
      order.order_shipping_packages.length > 0
      ? [...order.order_shipping_packages]
          .sort(
            (left: any, right: any) =>
              Number(left.package_number) - Number(right.package_number),
          )
          .map((parcel: any) => ({
            packageNumber: Number(parcel.package_number),
            carrier: String(parcel.shipping_carrier ?? order.shipping_carrier ?? ""),
            trackingNumber: String(parcel.tracking_number ?? ""),
          }))
      : String(order.shipping_tracking_number ?? "")
          .split(",")
          .map((trackingNumber: string, index: number) => ({
            packageNumber: index + 1,
            carrier: String(order.shipping_carrier ?? ""),
            trackingNumber: trackingNumber.trim(),
          })))
      .filter((parcel: { trackingNumber: string }) => parcel.trackingNumber)
  : [];
---

<MainLayout title="Track Order | Layer Forge Canada">

<section class="mx-auto max-w-5xl px-6 py-16">

{
  order ? (

    <div class="rounded-2xl bg-white p-10 shadow">

      <div class="mb-8 border-b pb-6">

        <h1 class="text-4xl font-bold">
          {orderNumber}
        </h1>

        <p class="mt-2 text-slate-500">
          Placed on {formatPacificDateTime(order.created_at)}
        </p>

      </div>

      {
        estimatedReadyDate && (
          <div class="mb-8 rounded-2xl border border-yellow-300 bg-yellow-50 p-6">
            <div class="text-sm font-semibold uppercase tracking-wide text-amber-700">
              {isLocalPickup ? "Estimated ready for pickup" : "Estimated ready to ship"}
            </div>
            <div class="mt-2 text-2xl font-bold text-slate-950">
              {estimatedReadyDate}
            </div>
            <p class="mt-2 text-sm text-slate-600">
              Based on {formatProductionDuration(productionDays)} after your order was placed.
              {!isLocalPickup && " Carrier transit time is additional."}
            </p>
          </div>
        )
      }

      <div class="grid gap-8 lg:grid-cols-2">

        <!-- Status -->

        <div>

         <h2 class="mb-6 text-2xl font-bold">
  Order Progress
</h2>

<div class="space-y-6">

  <div class="flex items-center gap-4">
    <div class="h-4 w-4 rounded-full bg-green-500"></div>
    <span>Order Received</span>
  </div>

  <div class="flex items-center gap-4">
    <div
      class={`h-4 w-4 rounded-full ${
        order.payment_status === "Paid"
          ? "bg-green-500"
          : "bg-slate-300"
      }`}
    ></div>
    <span>Payment Received</span>
  </div>

  <div class="flex items-center gap-4">
    <div
      class={`h-4 w-4 rounded-full ${
        ["In Progress", "Ready", "Shipped", "Completed"].includes(order.order_status)
          ? "bg-green-500"
          : "bg-slate-300"
      }`}
    ></div>
    <span>Production Started</span>
  </div>

  <div class="flex items-center gap-4">
    <div
      class={`h-4 w-4 rounded-full ${
        ["Ready", "Shipped", "Completed"].includes(order.order_status)
          ? "bg-green-500"
          : "bg-slate-300"
      }`}
    ></div>
    <span>
      {isLocalPickup ? "Ready for Pickup" : "Production Complete"}
    </span>
  </div>

  {
    !isLocalPickup && (
      <div class="flex items-center gap-4">
        <div
          class={`h-4 w-4 rounded-full ${
            ["Shipped", "Completed"].includes(order.order_status)
              ? "bg-green-500"
              : "bg-slate-300"
          }`}
        ></div>
        <span>Shipped</span>
      </div>
    )
  }

  <div class="flex items-center gap-4">
    <div
      class={`h-4 w-4 rounded-full ${
        order.order_status === "Completed"
          ? "bg-green-500"
          : "bg-slate-300"
      }`}
    ></div>
    <span>Completed</span>
  </div>

</div>

          {
            !isLocalPickup &&
              ["Shipped", "Completed"].includes(order.order_status) &&
              parcelTracking.length > 0 && (
                <div class="mt-10 rounded-2xl border border-blue-200 bg-blue-50 p-6">
                  <h2 class="text-2xl font-bold">Shipment Tracking</h2>
                  <div class="mt-4 space-y-4">
                    {parcelTracking.map((parcel: any) => (
                      <div class="rounded-xl bg-white p-4 shadow-sm">
                        <div class="text-sm font-semibold text-slate-500">
                          Package {parcel.packageNumber}
                        </div>
                        <div class="mt-1 font-semibold">
                          {parcel.carrier || "Carrier"}
                        </div>
                        <div class="mt-1 break-all text-slate-700">
                          {parcel.trackingNumber}
                        </div>
                      </div>
                    ))}
                  </div>
                  {carrierTrackingUrl && (
                    <a
                      href={carrierTrackingUrl}
                      target="_blank"
                      rel="noopener noreferrer"
                      class="mt-5 inline-block rounded-xl bg-slate-950 px-5 py-3 font-semibold text-white hover:bg-slate-800"
                    >
                      Track with Carrier
                    </a>
                  )}
                </div>
              )
          }

          <h2 class="mt-10 mb-4 text-2xl font-bold">
            Payment
          </h2>

          <span
            class={`rounded-full px-4 py-2 font-semibold ${
              order.payment_status === "Paid"
                ? "bg-green-100 text-green-700"
                : "bg-yellow-100 text-yellow-700"
            }`}
          >
            {order.payment_status}
          </span>

        </div>

        <!-- Products -->

        <div>

          <h2 class="mb-4 text-2xl font-bold">
            Products
          </h2>

          <div class="space-y-4">

            {
              order.order_items.map((item: any) => (

                <div class="rounded-xl border p-4">

                  <div class="font-semibold text-lg">
                    {item.product_name}
                  </div>

                  {
                    item.variant_name && (
                      <div class="mt-1 text-slate-500">
                        Variant: {item.variant_name}
                      </div>
                    )
                  }

                  <div class="mt-1 text-slate-500">
                    Material: {item.material}
                  </div>

                  <div class="text-slate-500">
                    Quantity: {item.quantity}
                  </div>

                  {
                    Number(item.production_days ?? 0) > 0 && (
                      <div class="text-sm text-amber-700">
                        Production: {formatProductionDuration(item.production_days)}
                      </div>
                    )
                  }

                  <div class="mt-2 font-semibold">
                    CAD ${Number(item.total_price).toFixed(2)}
                  </div>

                </div>

              ))
            }

          </div>

        </div>

      </div>

    </div>

  ) : (

    <div class="rounded-2xl bg-white p-12 text-center shadow">

      <div class="mb-4 text-6xl">
        🔍
      </div>

      <h1 class="text-3xl font-bold">
        Tracking Link Not Found
      </h1>

      <p class="mt-4 text-slate-500">
        The tracking link you used is invalid or has expired.
      </p>

      <a
        href="/"
        class="mt-8 inline-block rounded-xl bg-yellow-400 px-8 py-4 font-semibold text-slate-950 hover:bg-yellow-300"
      >
        Return Home
      </a>

    </div>

  )
}

</section>

</MainLayout>
