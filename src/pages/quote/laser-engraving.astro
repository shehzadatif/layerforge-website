---
import MainLayout from "../../layouts/MainLayout.astro";
import { getPacificDateInputValue } from "../../lib/dateUtils";
---

<MainLayout title="Laser Engraving Quote">

<section class="bg-slate-50 py-16">

  <div class="mx-auto max-w-3xl px-6">

    <div class="rounded-2xl bg-white p-8 shadow-lg">

      <h1 class="mb-2 text-4xl font-bold text-slate-900">
        Laser Engraving Quote
      </h1>

      <p class="mb-10 text-slate-600">
        Enter your engraving details for an instant preliminary estimate, then
        send the project to Layer Forge Canada for final price validation.
      </p>

      <div class="mb-10 rounded-xl border border-yellow-300 bg-yellow-50 p-5 text-sm leading-6 text-slate-700">
        <strong class="text-slate-950">Preliminary estimate only.</strong>
        Final pricing is confirmed after we review the artwork, material,
        engraving placement, and production settings. Contact us if you would
        like the price validated before submitting your item.
      </div>

   <form
      id="quoteForm"
      enctype="multipart/form-data"
      class="space-y-8"
    >
      <input
        type="hidden"
        name="service"
        value="Laser Engraving"
      />
      <input id="laserEstimateLow" type="hidden" name="laserEstimateLow" />
      <input id="laserEstimateHigh" type="hidden" name="laserEstimateHigh" />
      <input id="laserEstimateMidpoint" type="hidden" name="laserEstimateMidpoint" />
      <input id="laserEstimateHours" type="hidden" name="laserEstimateHours" />

      <section class="space-y-6">
        <h2 class="text-2xl font-bold text-slate-900">Artwork Upload</h2>

        <div>
          <label
            for="file"
            class="block text-sm font-semibold text-slate-700"
          >
            Artwork / Design File *
          </label>

          <label
            for="file"
            class="mt-3 flex cursor-pointer items-center justify-center rounded-xl border-2 border-dashed border-slate-300 bg-slate-50 px-6 py-10 text-center transition hover:border-yellow-400 hover:bg-yellow-50"
          >
            <div>
              <svg
                xmlns="http://www.w3.org/2000/svg"
                class="mx-auto mb-3 h-10 w-10 text-slate-400"
                fill="none"
                viewBox="0 0 24 24"
                stroke="currentColor"
                stroke-width="2"
              >
                <path
                  stroke-linecap="round"
                  stroke-linejoin="round"
                  d="M7 16V4m0 0L3 8m4-4l4 4M17 8v12m0 0l-4-4m4 4l4-4"
                />
              </svg>

              <p class="font-semibold text-slate-700">
                Click here to upload your file
              </p>

              <p class="mt-1 text-sm text-slate-500">
                AI, SVG, PDF, PNG, JPG, JPEG
              </p>

              <p
                id="selectedFileName"
                class="mt-3 hidden rounded-lg bg-green-100 px-4 py-2 text-sm font-semibold text-green-800"
                aria-live="polite"
              ></p>
            </div>
          </label>

          <input
            id="file"
            name="file"
            type="file"
            accept=".ai,.svg,.pdf,.png,.jpg,.jpeg"
            class="hidden"
          />
        </div>
      </section>

      <section class="space-y-6 border-t border-slate-200 pt-8">
        <h2 class="text-2xl font-bold text-slate-900">Item or Material Details</h2>

        <div class="space-y-6">
          <div>
            <label
              for="itemType"
              class="block text-sm font-semibold text-slate-700"
            >
              Item description (optional)
            </label>

            <input
              id="itemType"
              name="itemType"
              type="text"
              placeholder="Example: 20 oz tumbler, wooden sign, metal nameplate..."
              class="mt-2 block w-full rounded-xl border border-slate-300 bg-white p-3 shadow-sm focus:border-yellow-400 focus:outline-none focus:ring-2 focus:ring-yellow-400"
            />

            <p class="mt-2 text-sm text-slate-500">
              Describe the object being engraved. Select its material
              separately below.
            </p>
          </div>

          <div class="rounded-xl border border-slate-300 bg-slate-50 p-4">
            <label class="flex items-start gap-3">
              <input
                id="customerSupplied"
                name="customerSupplied"
                type="checkbox"
                value="Yes"
                class="mt-1 h-5 w-5 rounded border-slate-300 text-yellow-500 focus:ring-yellow-400"
              />

              <div>
                <span class="font-semibold text-slate-900">
                  I will provide the item or material.
                </span>

                <p class="mt-1 text-sm text-slate-600">
                  Check this box if you will bring or ship the item or material to Layer Forge Canada for engraving.
                </p>
              </div>
            </label>
          </div>

          <div class="grid gap-6 md:grid-cols-2">
            <div>
              <label for="engravingMaterial" class="block text-sm font-semibold text-slate-700">Material *</label>
              <select id="engravingMaterial" name="engravingMaterial" required class="mt-2 block w-full rounded-xl border border-slate-300 bg-white p-3 shadow-sm focus:border-yellow-400 focus:outline-none focus:ring-2 focus:ring-yellow-400">
                <option value="">Select material</option>
                <option value="wood">Wood</option>
                <option value="acrylic">Acrylic</option>
                <option value="anodized-aluminum">Anodized aluminum</option>
                <option value="coated-metal">Coated metal</option>
                <option value="glass">Glass</option>
                <option value="leather">Leather</option>
                <option value="other">Other / unsure</option>
              </select>
            </div>

            <div>
              <label for="engravingMode" class="block text-sm font-semibold text-slate-700">Artwork type *</label>
              <select id="engravingMode" name="engravingMode" required class="mt-2 block w-full rounded-xl border border-slate-300 bg-white p-3 shadow-sm focus:border-yellow-400 focus:outline-none focus:ring-2 focus:ring-yellow-400">
                <option value="raster">Filled image, photo, or solid text</option>
                <option value="vector">Outline or line artwork</option>
              </select>
            </div>

            <div>
              <label for="engravingWidth" class="block text-sm font-semibold text-slate-700">Engraving width *</label>
              <input id="engravingWidth" name="engravingWidth" type="number" min="0.1" step="0.1" required class="mt-2 block w-full rounded-xl border border-slate-300 bg-white p-3 shadow-sm focus:border-yellow-400 focus:outline-none focus:ring-2 focus:ring-yellow-400" />
            </div>

            <div>
              <label for="engravingHeight" class="block text-sm font-semibold text-slate-700">Engraving height *</label>
              <input id="engravingHeight" name="engravingHeight" type="number" min="0.1" step="0.1" required class="mt-2 block w-full rounded-xl border border-slate-300 bg-white p-3 shadow-sm focus:border-yellow-400 focus:outline-none focus:ring-2 focus:ring-yellow-400" />
            </div>

            <div>
              <label for="engravingUnits" class="block text-sm font-semibold text-slate-700">Dimension units *</label>
              <select id="engravingUnits" name="engravingUnits" required class="mt-2 block w-full rounded-xl border border-slate-300 bg-white p-3 shadow-sm focus:border-yellow-400 focus:outline-none focus:ring-2 focus:ring-yellow-400">
                <option value="mm">Millimetres</option>
                <option value="in">Inches</option>
              </select>
            </div>

            <div>
              <label for="engravingDetail" class="block text-sm font-semibold text-slate-700">Artwork detail *</label>
              <select id="engravingDetail" name="engravingDetail" required class="mt-2 block w-full rounded-xl border border-slate-300 bg-white p-3 shadow-sm focus:border-yellow-400 focus:outline-none focus:ring-2 focus:ring-yellow-400">
                <option value="simple">Simple</option>
                <option value="standard" selected>Standard</option>
                <option value="detailed">Detailed / photo</option>
              </select>
            </div>

            <div>
              <label for="engravingLocations" class="block text-sm font-semibold text-slate-700">Engraving locations per item *</label>
              <input id="engravingLocations" name="engravingLocations" type="number" value="1" min="1" max="20" required class="mt-2 block w-full rounded-xl border border-slate-300 bg-white p-3 shadow-sm focus:border-yellow-400 focus:outline-none focus:ring-2 focus:ring-yellow-400" />
            </div>

            <div>
              <label for="engravingSurface" class="block text-sm font-semibold text-slate-700">Surface *</label>
              <select id="engravingSurface" name="engravingSurface" required class="mt-2 block w-full rounded-xl border border-slate-300 bg-white p-3 shadow-sm focus:border-yellow-400 focus:outline-none focus:ring-2 focus:ring-yellow-400">
                <option value="flat">Flat surface</option>
                <option value="rotary">Round item / rotary engraving</option>
              </select>
            </div>

            <div>
              <label for="artworkReadiness" class="block text-sm font-semibold text-slate-700">Artwork readiness *</label>
              <select id="artworkReadiness" name="artworkReadiness" required class="mt-2 block w-full rounded-xl border border-slate-300 bg-white p-3 shadow-sm focus:border-yellow-400 focus:outline-none focus:ring-2 focus:ring-yellow-400">
                <option value="ready">Production-ready vector or high-resolution artwork</option>
                <option value="preparation">Artwork needs cleanup or preparation</option>
              </select>
            </div>

            <div>
              <label
                for="quantity"
                class="block text-sm font-semibold text-slate-700"
              >
                Quantity *
              </label>

              <input
                id="quantity"
                name="quantity"
                type="number"
                value="1"
                min="1"
                required
                class="mt-2 block w-full rounded-xl border border-slate-300 bg-white p-3 shadow-sm focus:border-yellow-400 focus:outline-none focus:ring-2 focus:ring-yellow-400"
              />
            </div>

            <div>
              <label
                for="deliveryMethod"
                class="block text-sm font-semibold text-slate-700"
              >
                Delivery Method
              </label>

              <select
                id="deliveryMethod"
                name="deliveryMethod"
                class="mt-2 block w-full rounded-xl border border-slate-300 bg-white p-3 shadow-sm focus:border-yellow-400 focus:outline-none focus:ring-2 focus:ring-yellow-400"
              >
                <option value="">Select Delivery Method</option>
                <option>Pickup</option>
                <option>Local Delivery</option>
                <option>Shipping</option>
              </select>
            </div>
          </div>
        </div>
      </section>

      <section id="laserEstimate" class="rounded-2xl border border-yellow-300 bg-yellow-50 p-6" aria-live="polite">
        <div class="flex flex-wrap items-center gap-3">
          <p class="text-sm font-bold uppercase tracking-[0.16em] text-yellow-700">Preliminary estimate</p>
          <span class="rounded-full bg-white px-3 py-1 text-xs font-semibold text-slate-600">Laser engraving</span>
        </div>
        <h2 id="laserEstimatePrice" class="mt-3 text-3xl font-bold text-slate-950">Enter engraving dimensions</h2>
        <p id="laserEstimateSummary" class="mt-2 text-sm text-slate-600">Choose the material and enter the engraved width and height to calculate.</p>
        <div class="mt-5 grid gap-4 sm:grid-cols-3">
          <div class="rounded-xl bg-white p-4"><span class="text-sm text-slate-500">Engraved area</span><strong id="laserEstimateArea" class="mt-1 block">—</strong></div>
          <div class="rounded-xl bg-white p-4"><span class="text-sm text-slate-500">Machine time</span><strong id="laserEstimateTime" class="mt-1 block">—</strong></div>
          <div class="rounded-xl bg-white p-4"><span class="text-sm text-slate-500">Quantity</span><strong id="laserEstimateQuantity" class="mt-1 block">1</strong></div>
        </div>
        <div class="mt-5 rounded-xl border border-amber-300 bg-white p-4 text-sm leading-6 text-slate-700">
          This estimate covers engraving service only. The item, material,
          shipping, tax, exceptional artwork repair, and special fixturing are
          not included. Contact Layer Forge Canada for a reviewed final price.
        </div>
      </section>

      <section class="space-y-6 border-t border-slate-200 pt-8">
        <h2 class="text-2xl font-bold text-slate-900">Schedule</h2>

        <div>
          <label
            for="dueDate"
            class="block text-sm font-semibold text-slate-700"
          >
            Desired Completion Date
          </label>

          <input
            id="dueDate"
            name="dueDate"
            type="date"
            min={getPacificDateInputValue(3)}
            class="mt-2 block w-full rounded-xl border border-slate-300 bg-white p-3 shadow-sm focus:border-yellow-400 focus:outline-none focus:ring-2 focus:ring-yellow-400"
          />

          <p class="mt-2 text-sm text-slate-500">
            Please allow at least 3 days for production. Rush orders may be accommodated upon request.
          </p>

          <div class="mt-3 rounded-lg border border-amber-200 bg-amber-50 p-3">
            <p class="text-sm text-amber-800">
              <strong>Important:</strong>
              The selected date is the estimated manufacturing completion date only.
              It does <strong>not</strong> include shipping, local delivery, or pickup time.
            </p>
          </div>
        </div>
      </section>

      <section class="space-y-6 border-t border-slate-200 pt-8">
        <h2 class="text-2xl font-bold text-slate-900">Customer Information</h2>

        <div class="grid gap-6 md:grid-cols-2">
          <div>
            <label
              for="name"
              class="block text-sm font-semibold text-slate-700"
            >
              Full Name *
            </label>

            <input
              id="name"
              name="name"
              type="text"
              required
              class="mt-2 block w-full rounded-xl border border-slate-300 bg-white p-3 shadow-sm focus:border-yellow-400 focus:outline-none focus:ring-2 focus:ring-yellow-400"
            />
          </div>

          <div>
            <label
              for="email"
              class="block text-sm font-semibold text-slate-700"
            >
              Email Address *
            </label>

            <input
              id="email"
              name="email"
              type="email"
              required
              class="mt-2 block w-full rounded-xl border border-slate-300 bg-white p-3 shadow-sm focus:border-yellow-400 focus:outline-none focus:ring-2 focus:ring-yellow-400"
            />
          </div>

          <div>
            <label
              for="phone"
              class="block text-sm font-semibold text-slate-700"
            >
              Phone Number
            </label>

            <input
              id="phone"
              name="phone"
              type="tel"
              class="mt-2 block w-full rounded-xl border border-slate-300 bg-white p-3 shadow-sm focus:border-yellow-400 focus:outline-none focus:ring-2 focus:ring-yellow-400"
            />
          </div>

          <div>
            <label
              for="company"
              class="block text-sm font-semibold text-slate-700"
            >
              Company
            </label>

            <input
              id="company"
              name="company"
              type="text"
              class="mt-2 block w-full rounded-xl border border-slate-300 bg-white p-3 shadow-sm focus:border-yellow-400 focus:outline-none focus:ring-2 focus:ring-yellow-400"
            />
          </div>
        </div>
      </section>

      <section class="space-y-6 border-t border-slate-200 pt-8">
        <h2 class="text-2xl font-bold text-slate-900">Project Details</h2>

        <label
          for="notes"
          class="block text-sm font-semibold text-slate-700"
        >
          Description
        </label>

        <textarea
          id="notes"
          name="notes"
          rows="6"
          placeholder="Describe the engraving, preferred placement, dimensions, personalization text, or any special instructions..."
          class="mt-2 block w-full rounded-xl border border-slate-300 bg-white p-3 shadow-sm focus:border-yellow-400 focus:outline-none focus:ring-2 focus:ring-yellow-400"
        ></textarea>
      </section>

      <div class="flex justify-center pt-6">
        <button
          type="submit"
          class="rounded-xl bg-yellow-400 px-12 py-4 text-lg font-semibold text-slate-900 shadow transition hover:bg-yellow-300"
        >
          Request Quote
        </button>
      </div>
    </form>

    </div>

  </div>

</section>

<script>
import { estimateLaserEngraving } from "../../lib/laserEngravingEstimator";

const form = document.getElementById("quoteForm");
const fileInput = document.querySelector<HTMLInputElement>("#file");
const selectedFileName =
  document.querySelector<HTMLElement>("#selectedFileName");

fileInput?.addEventListener("change", () => {
  const file = fileInput.files?.[0];

  if (!selectedFileName) return;

  if (file) {
    selectedFileName.textContent = `✓ Selected: ${file.name}`;
    selectedFileName.classList.remove("hidden");
  } else {
    selectedFileName.textContent = "";
    selectedFileName.classList.add("hidden");
  }
});

const fields = {
  width: document.querySelector<HTMLInputElement>("#engravingWidth"),
  height: document.querySelector<HTMLInputElement>("#engravingHeight"),
  units: document.querySelector<HTMLSelectElement>("#engravingUnits"),
  mode: document.querySelector<HTMLSelectElement>("#engravingMode"),
  material: document.querySelector<HTMLSelectElement>("#engravingMaterial"),
  detail: document.querySelector<HTMLSelectElement>("#engravingDetail"),
  locations: document.querySelector<HTMLInputElement>("#engravingLocations"),
  surface: document.querySelector<HTMLSelectElement>("#engravingSurface"),
  artwork: document.querySelector<HTMLSelectElement>("#artworkReadiness"),
  quantity: document.querySelector<HTMLInputElement>("#quantity"),
};
const output = {
  price: document.querySelector<HTMLElement>("#laserEstimatePrice"),
  summary: document.querySelector<HTMLElement>("#laserEstimateSummary"),
  area: document.querySelector<HTMLElement>("#laserEstimateArea"),
  time: document.querySelector<HTMLElement>("#laserEstimateTime"),
  quantity: document.querySelector<HTMLElement>("#laserEstimateQuantity"),
  low: document.querySelector<HTMLInputElement>("#laserEstimateLow"),
  high: document.querySelector<HTMLInputElement>("#laserEstimateHigh"),
  midpoint: document.querySelector<HTMLInputElement>("#laserEstimateMidpoint"),
  hours: document.querySelector<HTMLInputElement>("#laserEstimateHours"),
};
let laserPricing: Parameters<typeof estimateLaserEngraving>[1] | undefined;

function money(value: number) {
  return new Intl.NumberFormat("en-CA", { style: "currency", currency: "CAD" }).format(value);
}

function updateLaserEstimate() {
  if (!laserPricing || Object.values(fields).some((field) => !field) || !fields.material?.value || !fields.width?.value || !fields.height?.value) return;
  const estimate = estimateLaserEngraving({
    width: Number(fields.width.value),
    height: Number(fields.height.value),
    units: fields.units.value as "mm" | "in",
    mode: fields.mode.value as "raster" | "vector",
    material: fields.material.value as Parameters<typeof estimateLaserEngraving>[0]["material"],
    detail: fields.detail.value as Parameters<typeof estimateLaserEngraving>[0]["detail"],
    locations: Number(fields.locations.value),
    rotary: fields.surface.value === "rotary",
    quantity: Number(fields.quantity.value),
    artworkPreparation: fields.artwork.value === "preparation",
  }, laserPricing);
  if (!estimate) return;
  if (output.price) output.price.textContent = `${money(estimate.low)}–${money(estimate.high)}`;
  if (output.summary) output.summary.textContent = `Estimated engraving service total before tax and delivery. Midpoint: ${money(estimate.midpoint)}.`;
  if (output.area) output.area.textContent = `${estimate.areaCm2.toFixed(1)} cm² per location`;
  if (output.time) output.time.textContent = `${estimate.totalMachineHours < 1 ? `${Math.max(1, Math.round(estimate.totalMachineHours * 60))} min` : `${estimate.totalMachineHours.toFixed(1)} h`} total`;
  if (output.quantity) output.quantity.textContent = String(fields.quantity.value);
  if (output.low) output.low.value = estimate.low.toFixed(2);
  if (output.high) output.high.value = estimate.high.toFixed(2);
  if (output.midpoint) output.midpoint.value = estimate.midpoint.toFixed(2);
  if (output.hours) output.hours.value = estimate.totalMachineHours.toFixed(3);
}

Object.values(fields).forEach((field) => field?.addEventListener("input", updateLaserEstimate));
fetch("/api/quote/laser-engraving-pricing-config", { cache: "no-store" })
  .then((response) => {
    if (!response.ok) throw new Error("Pricing unavailable");
    return response.json();
  })
  .then((pricing) => { laserPricing = pricing; updateLaserEstimate(); })
  .catch(() => {
    if (output.price) output.price.textContent = "Contact us for an estimate";
    if (output.summary) output.summary.textContent = "The automatic estimator is temporarily unavailable. You can still submit your project for review.";
  });

form?.addEventListener("submit", async (e) => {

  e.preventDefault();

  const submitButton = form.querySelector("button[type='submit']");
  const originalText = submitButton.textContent;

  submitButton.disabled = true;
  submitButton.textContent = "Submitting...";

  try {

    const formData = new FormData(form);

    const response = await fetch("/api/quote", {
      method: "POST",
      body: formData,
    });

    const result = await response.json();

    if (result.success) {

      window.location.href = result.redirect;

      return;

    }

    alert(result.error || "Unable to submit quote.");

  } catch (err) {

    console.error(err);

    alert("Unexpected server error.");

  }

  submitButton.disabled = false;
  submitButton.textContent = originalText;

});

</script>
</MainLayout>
