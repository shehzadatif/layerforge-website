---
import MainLayout from "../../layouts/MainLayout.astro";
import { getPacificDateInputValue } from "../../lib/dateUtils";

const selectedItem = Astro.url.searchParams.get("item")?.trim().slice(0, 160) ?? "";
---

<MainLayout title="Request a Custom Product Quote | Layer Forge Canada" description="Tell Layer Forge Canada what item you want customized, the quantity, and what should go on it.">
  <section class="bg-slate-950 py-16 text-white sm:py-20">
    <div class="mx-auto max-w-4xl px-6">
      <p class="text-sm font-black uppercase tracking-[0.26em] text-yellow-400">Custom Branding &amp; Printing</p>
      <h1 class="mt-4 text-4xl font-black tracking-tight sm:text-5xl">Request a quote.</h1>
      <p class="mt-5 max-w-3xl text-lg leading-8 text-slate-300">Tell us what you want, how many you need, and what should go on it. We’ll reply with the available options, price, and timing.</p>
    </div>
  </section>

  <section class="bg-slate-100 py-12 sm:py-16">
    <div class="mx-auto max-w-4xl px-6">
      <form id="branding-project-form" enctype="multipart/form-data" class="space-y-8 rounded-3xl bg-white p-6 shadow-xl sm:p-10">
        <input type="hidden" name="service" value="Custom Branding & Printing" />
        <input type="text" name="website" tabindex="-1" autocomplete="off" class="hidden" aria-hidden="true" />

        <fieldset>
          <legend class="text-2xl font-black text-slate-950">What do you need?</legend>
          <div class="mt-6 grid gap-5 sm:grid-cols-2">
            {selectedItem ? (
              <div class="sm:col-span-2">
                <span class="text-sm font-bold text-slate-700">Selected item</span>
                <div class="mt-2 flex flex-wrap items-center justify-between gap-3 rounded-xl border-2 border-yellow-400 bg-yellow-50 px-5 py-4">
                  <strong class="text-lg text-slate-950">{selectedItem}</strong>
                  <a href="/what-we-make" class="text-sm font-bold text-slate-700 underline decoration-yellow-500 decoration-2 underline-offset-4">Choose a different item</a>
                </div>
                <input name="customItem" type="hidden" value={selectedItem} />
              </div>
            ) : (
              <label class="block sm:col-span-2">
                <span class="text-sm font-bold text-slate-700">Item *</span>
                <input name="customItem" type="text" maxlength="160" required placeholder="For example: tumblers, mouse pads, or gift boxes" class="mt-2 w-full rounded-xl border border-slate-300 px-4 py-3.5 focus:border-yellow-400 focus:outline-none focus:ring-2 focus:ring-yellow-200" />
              </label>
            )}
            <label class="block"><span class="text-sm font-bold text-slate-700">Quantity *</span><input name="quantity" type="number" min="1" max="10000" value="1" required class="mt-2 w-full rounded-xl border border-slate-300 px-4 py-3.5 focus:border-yellow-400 focus:outline-none focus:ring-2 focus:ring-yellow-200" /></label>
            <label class="block"><span class="text-sm font-bold text-slate-700">Needed by <span class="font-normal text-slate-500">(optional)</span></span><input name="dueDate" type="date" min={getPacificDateInputValue(3)} class="mt-2 w-full rounded-xl border border-slate-300 px-4 py-3.5 focus:border-yellow-400 focus:outline-none focus:ring-2 focus:ring-yellow-200" /></label>
            <label class="block sm:col-span-2">
              <span class="text-sm font-bold text-slate-700">Do you already have the item?</span>
              <select name="productSource" class="mt-2 w-full rounded-xl border border-slate-300 bg-white px-4 py-3.5 focus:border-yellow-400 focus:outline-none focus:ring-2 focus:ring-yellow-200">
                <option value="">I’m not sure</option><option>I need Layer Forge to supply it</option><option>I already have it</option>
              </select>
            </label>
            <label class="block sm:col-span-2">
              <span class="text-sm font-bold text-slate-700">What would you like on it? *</span>
              <textarea name="notes" rows="4" required placeholder="For example: our logo on one side, individual names on the other side, printed in black." class="mt-2 w-full rounded-xl border border-slate-300 px-4 py-3.5 focus:border-yellow-400 focus:outline-none focus:ring-2 focus:ring-yellow-200"></textarea>
            </label>
            <div class="sm:col-span-2">
              <span class="text-sm font-bold text-slate-700">Artwork or reference file <span class="font-normal text-slate-500">(optional)</span></span>
              <label for="branding-file" class="mt-2 flex cursor-pointer flex-col items-center justify-center rounded-2xl border-2 border-dashed border-slate-300 bg-slate-50 px-6 py-6 text-center transition hover:border-yellow-400 hover:bg-yellow-50">
                <span class="font-bold text-slate-800">Choose a file</span><span class="mt-1 text-sm text-slate-500">Logo, artwork, photo, or reference · up to 50 MB</span>
              </label>
              <input id="branding-file" name="file" type="file" accept=".ai,.svg,.eps,.pdf,.png,.jpg,.jpeg,.webp" class="hidden" />
              <p data-file-name class="mt-2 text-sm font-semibold text-slate-600" aria-live="polite"></p>
            </div>
          </div>
        </fieldset>

        <fieldset class="border-t border-slate-200 pt-8">
          <legend class="text-2xl font-black text-slate-950">Your contact details</legend>
          <div class="mt-6 grid gap-5 sm:grid-cols-2">
            <label class="block"><span class="text-sm font-bold text-slate-700">Full name *</span><input name="name" type="text" required autocomplete="name" class="mt-2 w-full rounded-xl border border-slate-300 px-4 py-3.5 focus:border-yellow-400 focus:outline-none focus:ring-2 focus:ring-yellow-200" /></label>
            <label class="block"><span class="text-sm font-bold text-slate-700">Email *</span><input name="email" type="email" required autocomplete="email" class="mt-2 w-full rounded-xl border border-slate-300 px-4 py-3.5 focus:border-yellow-400 focus:outline-none focus:ring-2 focus:ring-yellow-200" /></label>
            <label class="block"><span class="text-sm font-bold text-slate-700">Phone</span><input name="phone" type="tel" autocomplete="tel" class="mt-2 w-full rounded-xl border border-slate-300 px-4 py-3.5 focus:border-yellow-400 focus:outline-none focus:ring-2 focus:ring-yellow-200" /></label>
            <label class="block"><span class="text-sm font-bold text-slate-700">Business or organization</span><input name="company" type="text" autocomplete="organization" class="mt-2 w-full rounded-xl border border-slate-300 px-4 py-3.5 focus:border-yellow-400 focus:outline-none focus:ring-2 focus:ring-yellow-200" /></label>
          </div>
        </fieldset>

        <div class="rounded-2xl bg-yellow-50 p-5 text-sm leading-6 text-slate-700 ring-1 ring-yellow-200">We’ll check the item and reply with the price, available options, and timing.</div>
        <button type="submit" class="w-full rounded-xl bg-yellow-400 px-8 py-4 text-lg font-black text-slate-950 transition hover:bg-yellow-300 disabled:cursor-wait disabled:opacity-70">Request a Quote</button>
        <p data-form-error class="hidden rounded-xl border border-red-200 bg-red-50 p-4 text-sm font-semibold text-red-800" role="alert"></p>
      </form>
    </div>
  </section>

  <script>
    const form = document.querySelector<HTMLFormElement>("#branding-project-form");
    const fileInput = document.querySelector<HTMLInputElement>("#branding-file");
    const fileName = document.querySelector<HTMLElement>("[data-file-name]");
    const errorMessage = document.querySelector<HTMLElement>("[data-form-error]");
    fileInput?.addEventListener("change", () => { if (fileName) fileName.textContent = fileInput.files?.[0]?.name ? `Selected: ${fileInput.files[0].name}` : ""; });
    form?.addEventListener("submit", async (event) => {
      event.preventDefault();
      const button = form.querySelector<HTMLButtonElement>('button[type="submit"]');
      if (!button) return;
      button.disabled = true; button.textContent = "Sending…"; errorMessage?.classList.add("hidden");
      try {
        const response = await fetch("/api/quote", { method: "POST", body: new FormData(form) });
        const result = await response.json();
        if (result.success) { window.location.href = result.redirect; return; }
        throw new Error(result.error || "Unable to send your project details.");
      } catch (error) {
        if (errorMessage) { errorMessage.textContent = error instanceof Error ? error.message : "Unable to send your project details."; errorMessage.classList.remove("hidden"); }
        button.disabled = false; button.textContent = "Request a Quote";
      }
    });
  </script>
</MainLayout>
