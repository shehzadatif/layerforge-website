---
import MainLayout from "../../layouts/MainLayout.astro";
import ProductDescription from "../../components/products/ProductDescription.astro";
import { supabaseAdmin } from "../../lib/supabaseAdmin";
import ProductGallery from "../../features/shop/components/ProductGallery/ProductGallery";
import ProductConfiguratorWithProvider from "../../features/shop/components/ProductConfigurator/ProductConfiguratorWithProvider";

export const prerender = false;

const { slug } = Astro.params;

const { data: product } = await supabaseAdmin
  .from("products")
  .select(`
    *,
    categories(id, name, parent_id),
    product_images(*),
    product_variants(*),
    product_materials(
      material_id,
      materials(
        id,
        name,
        markup_percent,
        default_production_days
      )
    )
  `)
  .eq("slug", slug)
  .single();

if (!product) {
  return Astro.redirect("/shop");
}

const publicImageBase =
  `${import.meta.env.PUBLIC_SUPABASE_URL}/storage/v1/object/public/product-images/`;

function getPublicImageUrl(imagePath: string): string {
  return imagePath.startsWith("http://") || imagePath.startsWith("https://")
    ? imagePath
    : `${publicImageBase}${imagePath}`;
}

const productImageUrls = (product.product_images ?? [])
  .sort((a, b) => a.sort_order - b.sort_order)
  .map((image) => getPublicImageUrl(image.image_url));

const storefrontVariants = [...(product.product_variants ?? [])]
  .sort(
    (left, right) =>
      Number(left.sort_order ?? 0) - Number(right.sort_order ?? 0),
  )
  .map((variant) => ({
    ...variant,
    image_url: variant.image_url
      ? getPublicImageUrl(variant.image_url)
      : null,
  }));

const variantImageUrls = storefrontVariants
  .map((variant) => variant.image_url)
  .filter((imageUrl): imageUrl is string => Boolean(imageUrl));

const galleryImageUrls = [
  ...new Set([...productImageUrls, ...variantImageUrls]),
];

const cover = productImageUrls[0] ?? variantImageUrls[0] ?? "";

const storefrontProduct = {
  ...product,
  product_variants: storefrontVariants,
};

let parentCategory: { id: string; name: string } | null = null;

if (product.categories?.parent_id) {
  const parentCategoryResult = await supabaseAdmin
    .from("categories")
    .select("id, name")
    .eq("id", product.categories.parent_id)
    .maybeSingle();

  parentCategory = parentCategoryResult.data;
}

const categoryPath = [parentCategory?.name, product.categories?.name]
  .filter(Boolean)
  .join(" → ");
---

<MainLayout title={product.name}>

<section class="bg-slate-50 py-20">

  <div class="mx-auto max-w-7xl px-6">

    <a
      href="/shop"
      class="mb-8 inline-flex items-center gap-2 rounded-lg border border-slate-300 bg-white px-4 py-2.5 text-sm font-semibold text-slate-700 shadow-sm transition hover:border-yellow-400 hover:bg-yellow-50 hover:text-slate-950 focus:outline-none focus:ring-2 focus:ring-yellow-400 focus:ring-offset-2"
      aria-label="Back to Shop"
    >
      <svg
        aria-hidden="true"
        viewBox="0 0 20 20"
        fill="none"
        stroke="currentColor"
        stroke-width="1.8"
        class="h-4 w-4"
      >
        <path
          stroke-linecap="round"
          stroke-linejoin="round"
          d="m12.5 15-5-5 5-5"
        ></path>
      </svg>
      Back to Shop
    </a>

    <div class="grid gap-12 lg:grid-cols-2">

      <!-- Product Gallery -->

      <ProductGallery
        client:load
        images={galleryImageUrls}
        productName={product.name}
      />

      <!-- Product Information -->

      <div>

        <p class="mb-2 text-sm uppercase text-slate-500">
          {categoryPath}
        </p>

        <h1 class="mb-6 text-5xl font-bold">
          {product.name}
        </h1>

        <ProductDescription
          description={product.description}
          productName={product.name}
        />

        <ProductConfiguratorWithProvider
          client:load
          product={storefrontProduct}
          image={cover}
        />

      </div>

    </div>

  </div>

</section>

</MainLayout>
