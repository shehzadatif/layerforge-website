---

<MainLayout
  title="What We Customize | Layer Forge Canada"
  description="Search items Layer Forge Canada can customize for businesses, gifts, events, teams, home, and office."
  image="/images/home/layer-forge-hero.webp"
>
  <section class="bg-slate-950 py-20 text-white sm:py-24">
    <div class="mx-auto max-w-7xl px-6">
      <p class="text-sm font-black uppercase tracking-[0.26em] text-yellow-400">What we customize</p>
      <h1 class="mt-5 max-w-4xl text-5xl font-black tracking-tight sm:text-6xl">Find an item for your project.</h1>
      <p class="mt-6 max-w-3xl text-lg leading-8 text-slate-300">Search the list or choose a category. If you do not see your item, send us a photo and we will check it.</p>

      <div class="relative mt-10 max-w-4xl">
        <label for="item-search" class="sr-only">Search items</label>
        <svg aria-hidden="true" viewBox="0 0 24 24" fill="none" class="pointer-events-none absolute left-5 top-1/2 h-6 w-6 -translate-y-1/2 text-slate-500"><circle cx="11" cy="11" r="7" stroke="currentColor" stroke-width="2"></circle><path d="m16 16 4 4" stroke="currentColor" stroke-width="2" stroke-linecap="round"></path></svg>
        <input id="item-search" type="search" autocomplete="off" placeholder="Search tumblers, mouse pads, gift boxes…" class="w-full rounded-2xl border-2 border-transparent bg-white py-5 pl-14 pr-14 text-lg font-semibold text-slate-950 shadow-xl outline-none placeholder:font-normal placeholder:text-slate-500 focus:border-yellow-400 focus:ring-4 focus:ring-yellow-400/20" />
        <button id="clear-search" type="button" class="absolute right-4 top-1/2 hidden h-10 w-10 -translate-y-1/2 items-center justify-center rounded-full text-slate-500 hover:bg-slate-100 hover:text-slate-950" aria-label="Clear search">
          <svg aria-hidden="true" viewBox="0 0 24 24" fill="none" class="h-5 w-5"><path d="m7 7 10 10M17 7 7 17" stroke="currentColor" stroke-width="2" stroke-linecap="round"></path></svg>
        </button>
      </div>
    </div>
  </section>

  <div class="border-b border-slate-200 bg-white">
    <div class="mx-auto max-w-7xl px-6 py-5">
      <div class="flex gap-2 overflow-x-auto pb-1" role="group" aria-label="Filter items by category">
        {categories.map((category, index) => (
          <button type="button" data-filter={category.id} aria-pressed={index === 0 ? "true" : "false"} class={`whitespace-nowrap rounded-full border px-4 py-2.5 text-sm font-bold transition ${index === 0 ? "border-slate-950 bg-slate-950 text-white" : "border-slate-300 bg-white text-slate-700 hover:border-slate-950"}`}>
            {category.label}
          </button>
        ))}
      </div>
    </div>
  </div>

  <section class="bg-slate-100 py-14 sm:py-18">
    <div class="mx-auto max-w-7xl px-6">
      <div class="flex flex-wrap items-end justify-between gap-4">
        <div>
          <p class="text-sm font-black uppercase tracking-[0.22em] text-yellow-700">Item list</p>
          <h2 class="mt-2 text-3xl font-black text-slate-950">Choose what you want to customize</h2>
        </div>
        <p id="result-count" class="font-semibold text-slate-600" aria-live="polite">Showing all {items.length} items</p>
      </div>

      <div class="mt-10 space-y-14">
        {categories.slice(1).map((category) => {
          const categoryItems = items.filter((item) => item.category === category.id);
          return (
            <section id={category.id} data-category-group={category.id} class="scroll-mt-8">
              <div class="flex items-end justify-between gap-4 border-b border-slate-300 pb-4">
                <h3 class="text-2xl font-black text-slate-950 sm:text-3xl">{category.label}</h3>
                <p class="text-sm font-bold text-slate-500">{categoryItems.length} items</p>
              </div>
              <div class="mt-6 grid gap-4 sm:grid-cols-2 lg:grid-cols-3">
                {categoryItems.map((item) => {
                  const query = new URLSearchParams({ project: projectTypes[item.category], item: item.name });
                  return (
                    <article data-item data-category={item.category} data-search={`${item.name} ${item.detail} ${item.terms} ${categoryNames[item.category]}`.toLowerCase()} class="flex min-h-52 flex-col rounded-2xl border border-slate-200 bg-white p-6 shadow-sm transition hover:border-yellow-400 hover:shadow-lg">
                      <h4 class="text-2xl font-black text-slate-950">{item.name}</h4>
                      <p class="mt-3 flex-1 leading-7 text-slate-600">{item.detail}</p>
                      <a href={`/quote/custom-branding-printing?${query.toString()}`} class="mt-5 inline-flex w-fit rounded-lg border border-slate-300 px-4 py-2.5 text-sm font-bold text-slate-950 transition hover:border-slate-950 hover:bg-slate-950 hover:text-white">Ask about this item</a>
                    </article>
                  );
                })}
              </div>
            </section>
          );
        })}
      </div>

      <div id="no-results" class="mt-8 hidden rounded-3xl border-2 border-dashed border-slate-300 bg-white px-6 py-12 text-center">
        <h3 class="text-2xl font-black text-slate-950">Item not listed?</h3>
        <p class="mx-auto mt-3 max-w-2xl leading-7 text-slate-600">Send us a photo, the quantity, and what you want printed on it. We will check whether we can do it.</p>
        <a href="/additional-custom-projects" class="mt-6 inline-flex rounded-xl bg-slate-950 px-6 py-3 font-bold text-white hover:bg-slate-800">Ask About Another Item</a>
      </div>

      <div class="mt-12 rounded-3xl bg-yellow-400 p-8 text-slate-950 sm:flex sm:items-center sm:justify-between sm:gap-8 sm:p-10">
        <div>
          <h2 class="text-3xl font-black">Need several items for one project?</h2>
          <p class="mt-3 max-w-3xl leading-7 text-slate-800">Tell us what you need, how many, and when you need it. We can put the items together in one quote.</p>
        </div>
        <a href="/quote/custom-branding-printing?project=branding-package" class="mt-6 inline-flex shrink-0 rounded-xl bg-slate-950 px-7 py-4 font-black text-white hover:bg-slate-800 sm:mt-0">Request a Quote</a>
      </div>

      <p class="mt-7 text-center text-sm leading-6 text-slate-500">We check the item, material, size, artwork, quantity, and deadline before confirming the order.</p>
    </div>
  </section>

  <script>
    const searchInput = document.querySelector<HTMLInputElement>("#item-search");
    const clearButton = document.querySelector<HTMLButtonElement>("#clear-search");
    const count = document.querySelector<HTMLElement>("#result-count");
    const noResults = document.querySelector<HTMLElement>("#no-results");
    const itemCards = Array.from(document.querySelectorAll<HTMLElement>("[data-item]"));
    const categoryGroups = Array.from(document.querySelectorAll<HTMLElement>("[data-category-group]"));
    const filters = Array.from(document.querySelectorAll<HTMLButtonElement>("[data-filter]"));
    let selectedCategory = "all";

    const clean = (value: string) => value.toLowerCase().trim().replace(/[^a-z0-9]+/g, " ");

    const update = () => {
      const search = clean(searchInput?.value ?? "");
      let visible = 0;
      itemCards.forEach((card) => {
        const categoryMatch = selectedCategory === "all" || card.dataset.category === selectedCategory;
        const itemText = clean(card.dataset.search ?? "");
        const searchMatch = !search || search.split(" ").every((word) => itemText.includes(word));
        const show = categoryMatch && searchMatch;
        card.classList.toggle("hidden", !show);
        if (show) visible += 1;
      });
      categoryGroups.forEach((group) => {
        const hasVisibleItems = Array.from(group.querySelectorAll<HTMLElement>("[data-item]")).some((card) => !card.classList.contains("hidden"));
        group.classList.toggle("hidden", !hasVisibleItems);
      });
      clearButton?.classList.toggle("hidden", !searchInput?.value);
      clearButton?.classList.toggle("flex", Boolean(searchInput?.value));
      noResults?.classList.toggle("hidden", visible > 0);
      if (count) count.textContent = search ? `${visible} ${visible === 1 ? "match" : "matches"}` : `Showing ${visible} ${visible === 1 ? "item" : "items"}`;
    };

    filters.forEach((button) => button.addEventListener("click", () => {
      selectedCategory = button.dataset.filter ?? "all";
      filters.forEach((filter) => {
        const active = filter === button;
        filter.setAttribute("aria-pressed", String(active));
        filter.classList.toggle("border-slate-950", active);
        filter.classList.toggle("bg-slate-950", active);
        filter.classList.toggle("text-white", active);
        filter.classList.toggle("border-slate-300", !active);
        filter.classList.toggle("bg-white", !active);
        filter.classList.toggle("text-slate-700", !active);
      });
      update();
    }));
    searchInput?.addEventListener("input", update);
    clearButton?.addEventListener("click", () => {
      if (!searchInput) return;
      searchInput.value = "";
      searchInput.focus();
      update();
    });
  </script>
</MainLayout>
