---
import MainLayout from "../layouts/MainLayout.astro";

const solutions = [
  ["Product Branding", "Branded merchandise, drinkware, labels, promotional items, and coordinated product collections."],
  ["Branded Merchandise", "Promotional products, client gifts, employee items, and giveaways carrying your logo or campaign."],
  ["Workwear & Apparel", "Custom shirts, hoodies, uniforms, and event apparel for teams and organizations."],
  ["Labels & Stickers", "Product labels, packaging stickers, window decals, equipment labels, and custom-shaped graphics."],
  ["Events & Campaigns", "Coordinated apparel, giveaways, branded merchandise, and event products for launches and promotions."],
  ["Repeat & Quantity Orders", "Practical planning for consistent reorders, multiple products, and larger quantities."],
];
---

<MainLayout title="Custom Business Branding | Layer Forge Canada" description="Branded merchandise, apparel, labels, promotional products, and coordinated business projects from Layer Forge Canada.">
  <section class="bg-slate-950 py-24 text-white">
    <div class="mx-auto max-w-7xl px-6">
      <p class="font-bold uppercase tracking-[0.28em] text-yellow-400">For businesses</p>
      <h1 class="mt-5 max-w-4xl text-5xl font-black tracking-tight sm:text-6xl">Custom branding that works across your business.</h1>
      <p class="mt-7 max-w-3xl text-xl leading-8 text-slate-300">From one branded item to a coordinated set, we help you choose practical products and finishes that support your team, customers, events, and everyday operations.</p>
      <a href="/contact" class="mt-9 inline-flex rounded-xl bg-yellow-400 px-7 py-4 text-lg font-bold text-slate-950 transition hover:bg-yellow-300">Discuss a Business Project</a>
    </div>
  </section>
  <section class="bg-white py-24">
    <div class="mx-auto max-w-7xl px-6">
      <div class="grid gap-6 md:grid-cols-2 lg:grid-cols-3">
        {solutions.map(([title, description]) => (
          <article class="rounded-3xl border border-slate-200 p-8 shadow-sm"><div class="h-2 w-14 rounded-full bg-yellow-400"></div><h2 class="mt-6 text-2xl font-bold text-slate-950">{title}</h2><p class="mt-4 leading-7 text-slate-600">{description}</p></article>
        ))}
      </div>
      <section id="corporate-apparel" class="mt-20" aria-labelledby="corporate-apparel-heading">
        <div class="mx-auto max-w-3xl text-center">
          <p class="font-semibold uppercase tracking-[0.25em] text-yellow-600">Corporate apparel</p>
          <h2 id="corporate-apparel-heading" class="mt-3 text-3xl font-black text-slate-950 sm:text-4xl">Put your brand where customers can see it.</h2>
          <p class="mt-4 leading-7 text-slate-600">Create coordinated apparel for staff uniforms, corporate events, trade shows, restaurants, service teams, and promotions. Choose a small chest mark, a bold front graphic, a full back print, a sleeve logo, or a combination. Bring your logo or ask us to help prepare the artwork.</p>
        </div>
        <figure class="mx-auto mt-10 w-full max-w-6xl">
          <div class="grid gap-5 sm:grid-cols-2">
            <article class="overflow-hidden rounded-3xl border border-slate-200 bg-slate-50 shadow-lg">
              <img src="/images/apparel/corporate-left-chest.webp" alt="Navy polo with a small Northline logo on the left chest" width="1200" height="1200" loading="lazy" class="aspect-square w-full object-cover" />
              <div class="p-6"><h3 class="text-xl font-bold text-slate-950">Left chest logo</h3><p class="mt-2 leading-6 text-slate-600">A discreet mark for polos, uniforms, and everyday team wear.</p></div>
            </article>
            <article class="overflow-hidden rounded-3xl border border-slate-200 bg-slate-50 shadow-lg">
              <img src="/images/apparel/corporate-large-front.webp" alt="Charcoal T-shirt with a large Fieldwork logo printed across the front" width="1200" height="1200" loading="lazy" class="aspect-square w-full object-cover" />
              <div class="p-6"><h3 class="text-xl font-bold text-slate-950">Large front print</h3><p class="mt-2 leading-6 text-slate-600">Give a campaign, event, or staff shirt a strong focal point.</p></div>
            </article>
            <article class="overflow-hidden rounded-3xl border border-slate-200 bg-slate-50 shadow-lg">
              <img src="/images/apparel/corporate-full-back.webp" alt="Grey T-shirt viewed from behind with a large Evergreen logo printed on the back" width="1200" height="1200" loading="lazy" class="aspect-square w-full object-cover" />
              <div class="p-6"><h3 class="text-xl font-bold text-slate-950">Full back print</h3><p class="mt-2 leading-6 text-slate-600">Make your brand visible from behind at work or at events.</p></div>
            </article>
            <article class="overflow-hidden rounded-3xl border border-slate-200 bg-slate-50 shadow-lg">
              <img src="/images/apparel/corporate-sleeve.webp" alt="Black workwear T-shirt with a small Axiom logo printed on the sleeve" width="1200" height="1200" loading="lazy" class="aspect-square w-full object-cover" />
              <div class="p-6"><h3 class="text-xl font-bold text-slate-950">Sleeve logo</h3><p class="mt-2 leading-6 text-slate-600">Add a secondary mark without crowding the main design.</p></div>
            </article>
          </div>
          <figcaption class="mt-4 text-center text-sm leading-6 text-slate-500">Illustrative placement concepts, not customer orders. Your garments will use your approved logo, colours, placement, and artwork. Ask about right-chest, upper-back, and other positions for your garment.</figcaption>
        </figure>
      </section>
      <div class="mt-16 rounded-3xl bg-slate-100 p-8 sm:p-12">
        <h2 class="text-3xl font-bold text-slate-950">Every business project starts with a conversation.</h2>
        <p class="mt-4 max-w-3xl text-lg leading-8 text-slate-600">Share your logo, approximate quantity, deadline, and intended use. We’ll review the requirements with you and recommend the right approach before providing a quote.</p>
        <a href="/contact" class="mt-7 inline-flex font-bold text-slate-950 underline decoration-yellow-400 decoration-4 underline-offset-4">Contact us about your project →</a>
      </div>
    </div>
  </section>
</MainLayout>
