---
import MainLayout from "../../layouts/MainLayout.astro";

const notFound = Astro.url.searchParams.get("not-found") === "1";
---

<MainLayout title="Track Your Order | Layer Forge">

<section class="mx-auto max-w-2xl px-6 py-20">

  <h1 class="mb-4 text-center text-4xl font-bold">
    Track Your Order
  </h1>

  <p class="mb-10 text-center text-slate-600">
    Enter your Layer Forge order number and the email used for the order.
  </p>

  {
    notFound && (
      <div
        class="mb-6 rounded-xl border border-red-200 bg-red-50 px-5 py-4 text-center font-medium text-red-700"
        role="alert"
      >
        We could not match those details to an order. Check the order number and
        email, then try again.
      </div>
    )
  }

  <form
    action="/api/track-order"
    method="POST"
    class="rounded-2xl bg-white p-8 shadow"
  >

    <label for="orderNumber" class="mb-2 block font-semibold">
      Order Number
    </label>

    <input
      id="orderNumber"
      type="text"
      name="order"
      placeholder="LF000014"
      autocomplete="off"
      maxlength="20"
      class="w-full rounded-xl border p-4"
      required
    />

    <label for="orderEmail" class="mt-5 mb-2 block font-semibold">
      Order Email
    </label>

    <input
      id="orderEmail"
      type="email"
      name="email"
      placeholder="you@example.com"
      autocomplete="email"
      maxlength="254"
      class="w-full rounded-xl border p-4"
      required
    />

    <button
      class="mt-6 w-full rounded-xl bg-yellow-400 py-4 font-semibold text-slate-950 hover:bg-yellow-300"
    >
      Track Order
    </button>

  </form>

</section>

</MainLayout>
