{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "compatibility_date": "2026-07-19",
  "compatibility_flags": [
    "global_fetch_strictly_public",
    "nodejs_compat"
  ],
  "name": "layerforge-website",
  "main": "@astrojs/cloudflare/entrypoints/server",
  "keep_vars": true,
  "vars": {
    "STALLION_BASE_URL": "https://ship.stallion.ca/api/v5",
    "STALLION_DEFAULT_ITEM_WEIGHT_LBS": "0.5",
    "STALLION_PACKAGING_WEIGHT_LBS": "0.25",
    "STALLION_DEFAULT_PACKAGE_LENGTH_IN": "8",
    "STALLION_DEFAULT_PACKAGE_WIDTH_IN": "6",
    "STALLION_DEFAULT_PACKAGE_HEIGHT_IN": "4",
    "STALLION_STANDARD_BOXES_IN": "4x2x2,6x4x3,8x6x4,10x8x6,12x10x8,16x12x10,20x14x12,24x18x18"
  },
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS"
  },
  "observability": {
    "enabled": true
  }
}
