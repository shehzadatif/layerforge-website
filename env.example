# -------------------------------------------------------------------
# Layer Forge Canada
# Environment Variables
# Copy this file to .env and fill in your production values.
# -------------------------------------------------------------------

# -------------------------------------------------
# Supabase
# -------------------------------------------------

PUBLIC_SUPABASE_URL=https://your-project.supabase.co
PUBLIC_SUPABASE_ANON_KEY=your-public-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-server-only-service-role-key

# -------------------------------------------------
# Stripe
# -------------------------------------------------

STRIPE_SECRET_KEY=sk_live_xxxxxxxxxxxxxxxxx
STRIPE_WEBHOOK_SECRET=whsec_xxxxxxxxxxxxxxxx

PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_live_xxxxxxxxxxxxx

# -------------------------------------------------
# Email
# -------------------------------------------------

RESEND_API_KEY=re_xxxxxxxxxxxxxxxxx

FROM_EMAIL=noreply@yourdomain.com
QUOTE_FROM_EMAIL="Layer Forge Canada <quotes@yourdomain.com>"
QUOTE_TO_EMAIL=quotes@yourdomain.com
ORDER_FROM_EMAIL="Layer Forge Canada <orders@yourdomain.com>"
CONTACT_FROM_EMAIL="Layer Forge Canada <noreply@yourdomain.com>"
CONTACT_TO_EMAIL=support@yourdomain.com

# -------------------------------------------------
# Cloudflare Turnstile (recommended for production)
# -------------------------------------------------

PUBLIC_TURNSTILE_SITE_KEY=your-turnstile-site-key
TURNSTILE_SECRET_KEY=your-turnstile-secret-key

# -------------------------------------------------
# Bambu Studio quote refinement (Cloud Slicer, server-only)
# -------------------------------------------------

CLOUD_SLICER_API_TOKEN=your-cloud-slicer-api-token
CLOUD_SLICER_JOB_SIGNING_SECRET=generate-a-random-secret-with-at-least-32-characters
CLOUD_SLICER_PRINTER_ID=your-bambu-p1s-04mm-printer-profile-id
CLOUD_SLICER_FILAMENT_ID_PLA=your-pla-filament-profile-id
CLOUD_SLICER_FILAMENT_ID_PETG=your-petg-filament-profile-id
CLOUD_SLICER_FILAMENT_ID_ABS=your-abs-filament-profile-id
CLOUD_SLICER_FILAMENT_ID_TPU=your-tpu-filament-profile-id

# -------------------------------------------------
# Application
# -------------------------------------------------

PUBLIC_SITE_URL=https://yourdomain.com

NODE_ENV=production

# -------------------------------------------------
# Cloudflare Analytics (server-only Admin Dashboard)
# -------------------------------------------------

CLOUDFLARE_ZONE_ID=your-cloudflare-zone-id
CLOUDFLARE_ANALYTICS_API_TOKEN=your-zone-analytics-read-token
CLOUDFLARE_ANALYTICS_HOSTNAME=yourdomain.com
